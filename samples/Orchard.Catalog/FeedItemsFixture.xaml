<UserControl x:Class="Orchard.Catalog.FeedItemsFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <StackPanel Spacing="20" Margin="0,0,0,40">
  <TextBlock Text="Feed items" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24"/>
  <TextBlock Text="Fictional local metadata, normalized display categories and consumer-owned source requests." Style="{StaticResource BleeckerBodyStyle}" TextWrapping="Wrap"/>
  <TextBlock x:Name="Status" Text="No source requested." Style="{StaticResource BleeckerBodyStyle}"/>
  <orchard:BleeckerFeedColumn Title="Fictional local feed" Count="3" Height="480">
   <StackPanel>
