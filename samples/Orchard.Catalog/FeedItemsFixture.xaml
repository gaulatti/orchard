    <orchard:BleeckerFeedItem Author="" Content="AReallyLongUnbrokenLocalCoverageWordThatMustWrapAcrossMultipleLinesAtTheBoundary" LanguageCode="" PostedAt="bad timestamp" Relevance="0" SourceUrl="" SourceRequested="SourceRequested"/>
   </StackPanel>
  </orchard:BleeckerFeedColumn>
 </StackPanel>
</UserControl>
