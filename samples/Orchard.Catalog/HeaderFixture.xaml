<StackPanel x:Class="Orchard.Catalog.HeaderFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard" Spacing="20">
 <StackPanel.Resources>
  <DataTemplate x:Key="HeaderLink"><HyperlinkButton Content="{Binding Content}" Command="{Binding Command}" Style="{Binding Style}" Tag="{Binding Item}" ToolTipService.ToolTip="{Binding Href}" AutomationProperties.Name="{Binding Label}"/></DataTemplate>
 </StackPanel.Resources>
 <TextBlock Style="{StaticResource BleeckerHeadingStyle}" Text="Header"/>
 <TextBlock TextWrapping="Wrap" Text="Fictional local component navigation. Resize the viewport to show the mobile toggle. Caller-owned actions and link metadata survive menu changes."/>
 <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Toggle mobile navigation" Click="Toggle"/><Button Content="Reorder original items" Click="Reorder"/><Button Content="Toggle brand name" Click="Rename"/></StackPanel>
 <TextBlock x:Name="Status" Text="No host request"/>
 <TextBlock Text="Light and dark Header backgrounds retain their source opacity; the one-pixel bottom rule paints over the same background." TextWrapping="Wrap"/>
 <Grid MinHeight="460" BorderBrush="{ThemeResource BleeckerBorderBrush}" BorderThickness="1">
  <TextBlock Margin="16,96,16,0" Text="Header component content area with fictional local data." TextWrapping="Wrap"/>
  <orchard:BleeckerHeader x:Name="Default" Position="Static" ItemInvoked="Invoked" BrandInvoked="BrandInvoked">
   <orchard:BleeckerHeader.Brand><orchard:BleeckerHeaderBrand Href="#library" BrandName="Fictional library"/></orchard:BleeckerHeader.Brand>
   <orchard:BleeckerHeader.Actions><TextBox Width="170" Height="32" Text="Desktop caller input" AutomationProperties.Name="Header desktop caller input"/></orchard:BleeckerHeader.Actions>
   <orchard:BleeckerHeader.MobileActions><TextBox Width="170" Height="32" Text="Mobile caller input" AutomationProperties.Name="Header mobile caller input"/></orchard:BleeckerHeader.MobileActions>
  </orchard:BleeckerHeader>
 </Grid>
 <orchard:BleeckerHeader x:Name="Custom" Position="Static" FullWidth="True" LinkTemplate="{StaticResource HeaderLink}" ItemInvoked="Invoked" BrandInvoked="BrandInvoked">
  <orchard:BleeckerHeader.Brand><orchard:BleeckerHeaderBrand Href="#custom" BrandName="Custom host links"/></orchard:BleeckerHeader.Brand>
  <orchard:BleeckerHeader.Actions><Button Content="Caller action"/></orchard:BleeckerHeader.Actions>
 </orchard:BleeckerHeader>
 <TextBlock Style="{StaticResource BleeckerHeadingStyle}" Text="Header in AppShell"/>
 <orchard:BleeckerAppShell Height="420" MinHeight="0" OffsetHeader="False">
  <orchard:BleeckerAppShell.Header>
   <orchard:BleeckerHeader x:Name="Composed" Position="Static" ItemInvoked="Invoked" BrandInvoked="BrandInvoked">
    <orchard:BleeckerHeader.Brand><orchard:BleeckerHeaderBrand Href="#preview" BrandName="Fictional component preview"/></orchard:BleeckerHeader.Brand>
   </orchard:BleeckerHeader>
  </orchard:BleeckerAppShell.Header>
  <orchard:BleeckerAppShell.Content>
   <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="Compose navigation above caller-owned content." TextWrapping="Wrap"/>
    <TextBox Width="240" HorizontalAlignment="Left" Text="Fictional caller input" AutomationProperties.Name="Composed Header body input"/>
   </StackPanel>
  </orchard:BleeckerAppShell.Content>
  <orchard:BleeckerAppShell.Footer><TextBlock Margin="16" Text="Local component preview"/></orchard:BleeckerAppShell.Footer>
 </orchard:BleeckerAppShell>
</StackPanel>
