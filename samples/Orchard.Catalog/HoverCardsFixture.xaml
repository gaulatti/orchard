<StackPanel x:Class="Orchard.Catalog.HoverCardsFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard" Spacing="28">
 <TextBlock x:Name="Heading" Style="{StaticResource BleeckerHeadingStyle}" Text="Hover card"/>
 <TextBlock Text="Fictional local profiles. Inline surfaces follow pointer hover without taking focus or replacing the original controls." TextWrapping="Wrap"/>
 <StackPanel Orientation="Horizontal" Spacing="100" Margin="120,130,0,140">
  <orchard:BleeckerHoverCard x:Name="DefaultCard">
   <orchard:BleeckerHoverCard.Trigger><orchard:BleeckerButton x:Name="Contributor" Content="Fictional contributor" Size="Small" Click="ContributorClicked"/></orchard:BleeckerHoverCard.Trigger>
   <StackPanel Spacing="8"><TextBlock Text="Mira Quinn" FontWeight="SemiBold"/><TextBlock Text="Fictional component-library contributor" TextWrapping="Wrap"/><TextBox x:Name="CallerNote" Text="Original caller note" AutomationProperties.Name="Hover card caller note"/></StackPanel>
  </orchard:BleeckerHoverCard>
  <orchard:BleeckerHoverCard Side="Top">
   <orchard:BleeckerHoverCard.Trigger><Button Content="Top placement"/></orchard:BleeckerHoverCard.Trigger>
   <StackPanel Spacing="8"><TextBlock Text="Fictional top-side card"/><TextBlock Text="Placement preserves ancestor clipping and has no collision flip." TextWrapping="Wrap"/></StackPanel>
  </orchard:BleeckerHoverCard>
 </StackPanel>
 <TextBlock x:Name="ActionStatus" Text="Contributor actions: 0"/>
 <orchard:BleeckerHoverCard x:Name="DisabledCard" Margin="120,0,0,130">
  <orchard:BleeckerHoverCard.Trigger><Button x:Name="DisabledTrigger" Content="Disabled original trigger" IsEnabled="False"/></orchard:BleeckerHoverCard.Trigger>
  <TextBlock Text="The original disabled button stays disabled; its wrapper still supports hover." TextWrapping="Wrap"/>
 </orchard:BleeckerHoverCard>
 <TextBlock Text="Keyboard activation runs the trigger action. HoverCard adds no click toggle, focus capture or Escape dismissal. The source leaves visually closed content in the tab order." TextWrapping="Wrap"/>
</StackPanel>
