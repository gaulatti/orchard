<UserControl x:Class="Orchard.Catalog.InputsFixture"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <StackPanel Spacing="12" Margin="0,0,0,40" MaxWidth="480" HorizontalAlignment="Left">
  <TextBlock Text="Input · editing preview" Style="{StaticResource BleeckerHeadingStyle}" />
  <orchard:BleeckerInput x:Name="SmallInput" Width="320" InputSize="Small" PlaceholderText="Small input" AutomationProperties.Name="Small input" />
  <orchard:BleeckerInput x:Name="MediumInput" Width="320" PlaceholderText="Search channels..." AutomationProperties.Name="Search channels" />
  <orchard:BleeckerInput x:Name="LargeInput" Width="320" InputSize="Large" Text="Harbor update" AutomationProperties.Name="Large input" />
  <orchard:BleeckerInput x:Name="IconsInput" Width="320" PlaceholderText="Search or assign..." AutomationProperties.Name="Decorated input">
   <orchard:BleeckerInput.StartIcon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Ellipse Canvas.Left="3" Canvas.Top="3" Width="16" Height="16" Stroke="{ThemeResource BleeckerTextSecondaryBrush}" StrokeThickness="2" /><Path Data="M21,21 L16.65,16.65" Stroke="{ThemeResource BleeckerTextSecondaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox></orchard:BleeckerInput.StartIcon>
   <orchard:BleeckerInput.EndIcon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Ellipse Canvas.Left="8" Canvas.Top="3" Width="8" Height="8" Stroke="{ThemeResource BleeckerTextSecondaryBrush}" StrokeThickness="2" /><Path Data="M20,21 L20,19 C20,16.79 18.21,15 16,15 L8,15 C5.79,15 4,16.79 4,19 L4,21" Stroke="{ThemeResource BleeckerTextSecondaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox></orchard:BleeckerInput.EndIcon>
  </orchard:BleeckerInput>
  <orchard:BleeckerInput x:Name="ErrorInput" Width="320" IsError="True" Text="broken-stream-url" AutomationProperties.Name="Invalid stream" />
  <orchard:BleeckerInput x:Name="DisabledInput" Width="320" IsEnabled="False" Text="Unavailable input" />
  <orchard:BleeckerInput x:Name="DisabledErrorInput" Width="320" IsEnabled="False" IsError="True" Text="Unavailable invalid input" />
  <orchard:BleeckerInput x:Name="ReadOnlyInput" Width="320" IsReadOnly="True" Text="Read-only coverage" AutomationProperties.Name="Read-only coverage" />
  <orchard:BleeckerInput Width="160" Text="東京 · São Paulo · القاهرة · long coverage value" AutomationProperties.Name="Constrained multilingual input" />
 </StackPanel>
</UserControl>
