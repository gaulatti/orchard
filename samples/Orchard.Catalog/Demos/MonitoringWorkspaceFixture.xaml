<UserControl x:Class="Orchard.Catalog.Demos.MonitoringWorkspaceFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <StackPanel Spacing="16" Margin="0,0,0,32">
  <TextBlock Text="Monitoring component demo" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24"/>
  <TextBlock Text="Fictional local data · updates and reviews stay in memory · no services or accounts" Style="{StaticResource BleeckerBodyStyle}" TextWrapping="Wrap"/>
  <orchard:BleeckerAppShell x:Name="Shell" MinHeight="720" OffsetHeader="False">
   <orchard:BleeckerAppShell.Header>
    <Grid Height="60" Padding="12,0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <orchard:BleeckerHeaderSelect x:Name="Suite" Value="monitoring" AutomationProperties.Name="Component demo suite"/>
     <orchard:BleeckerButton x:Name="Update" Grid.Column="1" Content="Simulate local update" Size="Small" Variant="Secondary"/>
     <orchard:BleeckerButton x:Name="Review" Grid.Column="2" Content="Review selected" Size="Small"/>
    </Grid>
   </orchard:BleeckerAppShell.Header>
   <Grid Height="630">
    <Grid x:Name="Workspace" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <orchard:BleeckerSidebar x:Name="Sidebar" Width="192" Height="620" Header="Monitoring" Footer="Fictional local preview"/>
     <Grid Grid.Column="1" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="Summary" Style="{StaticResource BleeckerBodyStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <ScrollViewer x:Name="FeedScroll" Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Columns" Orientation="Horizontal" Spacing="12"/></ScrollViewer>
      <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" Visibility="Collapsed"><StackPanel x:Name="History" Spacing="12"/></ScrollViewer>
      <orchard:BleeckerPanel x:Name="Inspector" Grid.Row="2" Title="Selected post" Visibility="Collapsed" Width="500" HorizontalAlignment="Left">
       <TextBlock x:Name="InspectorText" Style="{StaticResource BleeckerBodyStyle}" TextWrapping="Wrap"/>
      </orchard:BleeckerPanel>
     </Grid>
    </Grid>
    <Grid x:Name="ReviewOverlay" Visibility="Collapsed" TabFocusNavigation="Cycle" KeyDown="ReviewKeyDown">
     <Border Background="{ThemeResource BleeckerBackgroundBrush}" Opacity="0.9"/>
     <orchard:BleeckerPanel Title="Processing review" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Local processing review">
      <StackPanel Spacing="12">
       <TextBlock x:Name="ReviewSummary" Style="{StaticResource BleeckerBodyStyle}" TextWrapping="Wrap"/>
       <orchard:BleeckerField Label="Local instructions" Optional="True"><orchard:BleeckerTextarea x:Name="Instructions" Rows="3"/></orchard:BleeckerField>
       <StackPanel x:Name="DiscardReview" Visibility="Collapsed" Spacing="8">
        <TextBlock Text="Discard the unsaved local instructions?" Style="{StaticResource BleeckerBodyStyle}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><orchard:BleeckerButton x:Name="KeepReview" Content="Keep editing" Variant="Secondary" Size="Small"/><orchard:BleeckerButton x:Name="ConfirmDiscard" Content="Discard instructions" Variant="Destructive" Size="Small"/></StackPanel>
       </StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="8"><orchard:BleeckerButton x:Name="Back" Content="Back" Variant="Secondary" Size="Small"/><orchard:BleeckerButton x:Name="RecordReview" Content="Record local review" Size="Small"/></StackPanel>
      </StackPanel>
     </orchard:BleeckerPanel>
    </Grid>
   </Grid>
   <orchard:BleeckerAppShell.Footer><TextBlock x:Name="Feedback" Style="{StaticResource BleeckerBodyStyle}" Margin="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></orchard:BleeckerAppShell.Footer>
  </orchard:BleeckerAppShell>
 </StackPanel>
</UserControl>
