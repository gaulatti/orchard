<UserControl x:Class="Orchard.Catalog.LineChartsFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <StackPanel Spacing="16" Margin="0,0,0,24">
  <TextBlock Text="Line charts" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
  <TextBlock Text="Consumer records and series, native monotone curves and category inspection." Style="{StaticResource BleeckerBodyStyle}" TextWrapping="Wrap" />
  <Grid x:Name="ChartStage" HorizontalAlignment="Left">
   <Canvas x:Name="BlurProbe" IsHitTestVisible="False" Visibility="Collapsed" />
   <orchard:BleeckerLineChart x:Name="Chart" XAxisKey="label" Width="640" HorizontalAlignment="Left" AutomationProperties.Name="Fictional coverage totals" />
  </Grid>
  <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="Before" Content="Before chart" Style="{StaticResource BleeckerSecondaryButtonStyle}" /><Button x:Name="After" Content="After chart" Style="{StaticResource BleeckerSecondaryButtonStyle}" /></StackPanel>
 </StackPanel>
</UserControl>
