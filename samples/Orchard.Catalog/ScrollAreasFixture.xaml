<StackPanel x:Class="Orchard.Catalog.ScrollAreasFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard" Spacing="20">
 <TextBlock Style="{StaticResource BleeckerHeadingStyle}" Text="Scroll area"/>
 <TextBlock Text="Fictional local component content. Each viewport retains the original editor and controls while its orientation and maximum height change." TextWrapping="Wrap"/>
 <StackPanel Orientation="Horizontal" Spacing="16"><Button Content="Vertical" Click="Vertical"/><Button Content="Horizontal" Click="Horizontal"/><Button Content="Both" Click="Both"/><Button Content="Toggle maximum height" Click="Maximum"/><Button Content="Toggle direction" Click="Direction"/><Button Content="Scroll to 80 / 120" Click="Scroll"/></StackPanel>
 <orchard:BleeckerScrollArea x:Name="Area" Width="360" MaxHeight="240" IsTabStop="True" AutomationProperties.Name="Fictional original-content scroll area" ViewChanged="Changed">
  <StackPanel Width="620" Spacing="16">
   <TextBlock Text="Fictional component-library notes" FontWeight="SemiBold"/>
   <TextBox Text="Original caller editor — edits and selection stay here" AutomationProperties.Name="Original caller scroll-area note"/>
   <Button Content="Original caller action" HorizontalAlignment="Left" Click="Action"/>
   <Border Height="180" Background="{ThemeResource BleeckerLightSandBrush}"><TextBlock Margin="16" Text="Fictional local content extends beyond the viewport in both axes." TextWrapping="Wrap"/></Border>
   <TextBlock Text="End of original content" Margin="0,0,0,16"/>
  </StackPanel>
 </orchard:BleeckerScrollArea>
 <TextBlock x:Name="Status" Text="Ready" TextWrapping="Wrap"/>
 <TextBlock Text="Naturally wrapping content" FontWeight="SemiBold"/>
 <orchard:BleeckerScrollArea Width="256" MaxHeight="96" IsTabStop="True" AutomationProperties.Name="Fictional wrapping scroll area">
  <TextBlock Text="This caller-owned text wraps within the remaining client width. Scrollbars reserve their space and do not cover interactive content. The area adds no data loading, selection or virtualization policy." TextWrapping="Wrap"/>
 </orchard:BleeckerScrollArea>
 <orchard:BleeckerScrollArea Width="256" MaxHeight="80" AutomationProperties.Name="Empty scroll area"/>
 <TextBlock Text="Scrolling theme styles" FontWeight="SemiBold"/>
 <ScrollView Width="256" MaxHeight="80" ContentOrientation="Vertical" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" Style="{StaticResource BleeckerScrollAreaViewportStyle}" AutomationProperties.Name="Fictional styled native viewport">
  <TextBlock Height="240" Text="Fictional caller content using the shared viewport theme recipe." TextWrapping="Wrap"/>
 </ScrollView>
 <ScrollBar Width="256" Height="15" Orientation="Horizontal" Minimum="0" Maximum="100" ViewportSize="25" Value="30" Style="{StaticResource ScrollAreaBarStyle}" AutomationProperties.Name="Fictional styled scrollbar"/>
</StackPanel>
