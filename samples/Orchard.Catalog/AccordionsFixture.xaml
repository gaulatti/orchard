<UserControl x:Class="Orchard.Catalog.AccordionsFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <StackPanel Spacing="16" Margin="0,0,0,40">
  <TextBlock Text="Accordion" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24"/>
  <Button Style="{StaticResource BleeckerAccordionHeaderStyle}" AutomationProperties.Name="Accordion header style"><TextBlock Text="Header appearance" FontFamily="{StaticResource BleeckerPrimaryMediumFontFamily}" FontSize="14" Margin="16"/></Button>
  <TextBlock Text="One expanded section; actions remain independent" Style="{StaticResource BleeckerBodyStyle}"/>
  <orchard:BleeckerAccordion x:Name="Example" DefaultExpandedId="first" AutomationProperties.Name="Delivery preferences"/>
  <TextBlock x:Name="ActionStatus" Text="No header action invoked" Style="{StaticResource BleeckerBodyStyle}"/>
  <TextBlock Text="Rich content is retained when a section closes" Style="{StaticResource BleeckerBodyStyle}"/>
  <orchard:BleeckerAccordion x:Name="Rich" AutomationProperties.Name="Reader settings"><orchard:BleeckerAccordion.Items><orchard:BleeckerAccordionItem Id="reader" Title="Reader preferences" Subtitle="Consumer-owned input state"><orchard:BleeckerAccordionItem.Content><Border Padding="16"><TextBox Header="Saved reader name" Text="Harbor"/></Border></orchard:BleeckerAccordionItem.Content></orchard:BleeckerAccordionItem></orchard:BleeckerAccordion.Items></orchard:BleeckerAccordion>
  <TextBlock Text="Disabled group" Style="{StaticResource BleeckerBodyStyle}"/>
  <orchard:BleeckerAccordion x:Name="Disabled" IsEnabled="False" AutomationProperties.Name="Disabled delivery preferences"/>
  <TextBlock Text="Empty group" Style="{StaticResource BleeckerBodyStyle}"/>
  <orchard:BleeckerAccordion x:Name="Empty" AutomationProperties.Name="Empty preferences"/>
 </StackPanel>
</UserControl>
