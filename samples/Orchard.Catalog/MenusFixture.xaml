<UserControl x:Class="Orchard.Catalog.MenusFixture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
    <StackPanel Spacing="16">
        <TextBlock Text="Dropdown menus" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
        <orchard:BleeckerOverlaySurface x:Name="ShadowPreview" Width="224" Padding="14" HorizontalAlignment="Left" Margin="0,0,0,32">
            <TextBlock Text="Overlay surface preview" Style="{StaticResource BleeckerBodyStyle}" />
        </orchard:BleeckerOverlaySurface>
        <Button x:Name="Trigger" Content="Display options" HorizontalAlignment="Left" Style="{StaticResource BleeckerSecondaryButtonStyle}">
            <Button.Flyout>
                <orchard:BleeckerDropdownMenu x:Name="Menu">
                    <orchard:BleeckerMenuLabel x:Name="SectionLabel" Text="Account" />
                    <MenuFlyoutItem x:Name="Action" Text="Profile" Click="OnAction" orchard:BleeckerMenuFocus.IsEnabled="True" Style="{StaticResource BleeckerMenuItemStyle}" />
                    <MenuFlyoutItem Text="Settings" KeyboardAcceleratorTextOverride="Ctrl+S" Style="{StaticResource BleeckerMenuItemStyle}" />
                    <MenuFlyoutItem Text="Unavailable" IsEnabled="False" Style="{StaticResource BleeckerMenuItemStyle}" />
                    <MenuFlyoutSeparator Style="{StaticResource BleeckerMenuSeparatorStyle}" />
                    <orchard:BleeckerMenuLabel Text="Visible fields" Inset="True" />
                    <ToggleMenuFlyoutItem x:Name="Checkbox" Text="Revenue" IsChecked="True" Style="{StaticResource BleeckerMenuCheckboxStyle}" />
                    <RadioMenuFlyoutItem x:Name="Compact" Text="Compact" GroupName="CatalogDensity" Style="{StaticResource BleeckerMenuRadioStyle}" />
                    <RadioMenuFlyoutItem x:Name="Comfortable" Text="Comfortable" GroupName="CatalogDensity" IsChecked="True" Style="{StaticResource BleeckerMenuRadioStyle}" />
                    <MenuFlyoutSubItem x:Name="Submenu" Text="More options" Style="{StaticResource BleeckerMenuSubmenuStyle}">
                        <MenuFlyoutItem Text="Archive" Style="{StaticResource BleeckerMenuItemStyle}" />
                    </MenuFlyoutSubItem>
                </orchard:BleeckerDropdownMenu>
            </Button.Flyout>
        </Button>
        <TextBlock x:Name="Result" Text="No menu action yet" Style="{StaticResource BleeckerBodyStyle}" />
        <Button Content="Native presenter style" HorizontalAlignment="Left" Style="{StaticResource BleeckerSecondaryButtonStyle}">
            <Button.Flyout><MenuFlyout MenuFlyoutPresenterStyle="{StaticResource BleeckerMenuPresenterStyle}" AreOpenCloseAnimationsEnabled="False">
                <MenuFlyoutItem Text="Native integration" Style="{StaticResource BleeckerMenuItemStyle}" />
            </MenuFlyout></Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
