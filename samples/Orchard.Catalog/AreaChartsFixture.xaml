<UserControl x:Class="Orchard.Catalog.AreaChartsFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <StackPanel Spacing="24" Margin="0,0,0,40">
  <TextBlock Text="Area charts" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
  <TextBlock Text="Fictional local collections. Consumers own records, series, formatting and accessible names. Focus a chart to inspect categories." Style="{StaticResource BleeckerBodyStyle}" />
  <orchard:BleeckerAreaChart x:Name="Specimen" XAxisKey="label" Height="300" AutomationProperties.Name="Fictional collection totals">
   <orchard:BleeckerAreaChart.Series><orchard:BleeckerChartSeries Key="total" Name="Consumer total" /><orchard:BleeckerChartSeries Key="selected" Name="Consumer selected" /></orchard:BleeckerAreaChart.Series>
  </orchard:BleeckerAreaChart>
  <orchard:BleeckerAreaChart x:Name="StackedSpecimen" XAxisKey="label" Stacked="True" Height="300" AutomationProperties.Name="Fictional stacked comparison">
   <orchard:BleeckerAreaChart.Series><orchard:BleeckerChartSeries Key="total" Name="Consumer total" /><orchard:BleeckerChartSeries Key="selected" Name="Consumer selected" /></orchard:BleeckerAreaChart.Series>
  </orchard:BleeckerAreaChart>
 </StackPanel>
</UserControl>
