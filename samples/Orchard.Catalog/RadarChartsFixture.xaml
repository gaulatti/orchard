<UserControl x:Class="Orchard.Catalog.RadarChartsFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <StackPanel Spacing="24" Margin="0,0,0,40">
  <TextBlock Text="Radar charts" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
  <TextBlock Text="Fictional consumer-owned subjects and series. Use Left, Right and Enter to inspect each subject." Style="{StaticResource BleeckerBodyStyle}" />
  <orchard:BleeckerRadarChart x:Name="Specimen" SubjectKey="subject" AutomationProperties.Name="Fictional polar collection">
   <orchard:BleeckerRadarChart.Series><orchard:BleeckerRadarSeries Key="a" Name="Harbor" Fill="True" /><orchard:BleeckerRadarSeries Key="b" Name="Terrace" /></orchard:BleeckerRadarChart.Series>
  </orchard:BleeckerRadarChart>
 </StackPanel>
</UserControl>
