<UserControl x:Class="Orchard.Catalog.DataListsFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <UserControl.Resources><ControlTemplate x:Key="InlineActionTemplate" TargetType="Button"><ContentPresenter Content="{TemplateBinding Content}" /></ControlTemplate></UserControl.Resources>
 <StackPanel Spacing="16">
  <TextBlock Text="Data list" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
  <TextBlock Text="Consumer-owned terms and values · viewport-responsive columns · optional stripes" Style="{StaticResource BleeckerBodyStyle}" TextWrapping="Wrap" />
  <ComboBox x:Name="CasePicker" Width="280" Header="Source case" AutomationProperties.Name="Data list source case" SelectionChanged="CaseChanged" />
  <Canvas x:Name="Frame" Width="1024" Height="900" HorizontalAlignment="Left" UseLayoutRounding="False">
   <orchard:BleeckerDataList x:Name="List" Canvas.Left="20" Canvas.Top="20" Width="640" AutomationProperties.Name="Editorial metadata">
    <orchard:BleeckerDataList.Items><orchard:BleeckerDataListItem Id="title" Label="Title" Value="Harbor dispatch" Description="Fictional editorial metadata" /></orchard:BleeckerDataList.Items>
   </orchard:BleeckerDataList>
  </Canvas>
 </StackPanel>
</UserControl>
