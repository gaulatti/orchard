<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <RootNamespace>Orchard.Catalog</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Platforms>x64;ARM64</Platforms>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
        <UseWinUI>true</UseWinUI>
        <WinUISDKReferences>false</WinUISDKReferences>
        <EnableMsixTooling>true</EnableMsixTooling>
        <AppxGeneratePriEnabled>true</AppxGeneratePriEnabled>
        <ProjectPriFileName>resources.pri</ProjectPriFileName>
        <PrependPriInitialPath>false</PrependPriInitialPath>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <SelfContained>true</SelfContained>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>false</PublishSingleFile>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Manifest Include="$(ApplicationManifest)" />
        <EmbeddedResource Include="Reference/InputTypography.json" />
        <EmbeddedResource Include="Reference/BauhausPixels.json" />
        <EmbeddedResource Include="Reference/BauhausNarrow.json" />
        <EmbeddedResource Include="Reference/BauhausRaster.json" />
        <EmbeddedResource Include="Reference/BauhausAutostrada.png" />
        <EmbeddedResource Include="Reference/BauhausPompeii.png" />
        <EmbeddedResource Include="Reference/ActivityLayout.json" />
        <EmbeddedResource Include="Reference/AttentionLayout.json" />
        <EmbeddedResource Include="Reference/LineLayout.json" />
        <EmbeddedResource Include="Reference/LineTooltip.json" />
        <EmbeddedResource Include="Reference/LineBlur.json" />
        <EmbeddedResource Include="Reference/LineShadow.json" />
        <EmbeddedResource Include="Reference/LineInteraction.json" />
        <EmbeddedResource Include="Reference/ErrorStateLayout.json" />
        <EmbeddedResource Include="../../tests/Reference/PageHeaderLayout.json" LogicalName="Orchard.Catalog.Reference.PageHeaderLayout.json" />
        <EmbeddedResource Include="../../tests/Reference/SectionHeaderLayout.json" LogicalName="Orchard.Catalog.Reference.SectionHeaderLayout.json" />
        <EmbeddedResource Include="../../tests/Reference/DashboardSectionLayout.json" LogicalName="Orchard.Catalog.Reference.DashboardSectionLayout.json" />
        <EmbeddedResource Include="../../tests/Reference/DashboardGridLayout.json" LogicalName="Orchard.Catalog.Reference.DashboardGridLayout.json" />
        <None Include="../../licenses/LICENSE-Lucide.txt" Link="licenses/LICENSE-Lucide.txt" CopyToOutputDirectory="PreserveNewest" />
        <ProjectReference Include="../../src/Orchard/Orchard.csproj" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    </ItemGroup>
</Project>
