<UserControl x:Class="Orchard.Catalog.MenubarsFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <StackPanel Spacing="20" Margin="0,0,0,40">
  <TextBlock Text="Menubar" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24"/>
  <TextBlock Text="Fictional actions with caller-owned checkbox and radio values. Shortcut labels are display hints." Style="{StaticResource BleeckerBodyStyle}" TextWrapping="Wrap"/>
  <orchard:BleeckerMenubar x:Name="Default" Width="420" HorizontalAlignment="Left" AutomationProperties.Name="Fictional editing commands" TriggerStyle="{StaticResource BleeckerMenubarTriggerStyle}" ItemStyle="{StaticResource BleeckerMenubarItemStyle}" SurfaceStyle="{StaticResource BleeckerMenubarSurfaceStyle}" SubmenuSurfaceStyle="{StaticResource BleeckerMenubarSubmenuSurfaceStyle}"/>
  <TextBlock x:Name="Result" Text="No fictional action selected" Style="{StaticResource BleeckerBodyStyle}" TextWrapping="Wrap"/>
  <TextBlock Text="Disabled and empty" Style="{StaticResource BleeckerBodyStyle}"/>
  <orchard:BleeckerMenubar x:Name="Disabled" Width="420" HorizontalAlignment="Left" IsEnabled="False" AutomationProperties.Name="Disabled fictional editing commands"/>
  <orchard:BleeckerMenubar x:Name="Empty" Width="420" HorizontalAlignment="Left" AutomationProperties.Name="Empty fictional menu bar"/>
  <TextBlock Text="Right to left" Style="{StaticResource BleeckerBodyStyle}"/>
  <orchard:BleeckerMenubar x:Name="Rtl" Width="420" HorizontalAlignment="Left" FlowDirection="RightToLeft" AutomationProperties.Name="Fictional commands, right to left"/>
 </StackPanel>
</UserControl>
