<StackPanel x:Class="Orchard.Catalog.EdgeDialogsFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:o="using:Orchard" Spacing="16">
 <TextBlock Text="Drawer and Sheet" Style="{StaticResource BleeckerHeadingStyle}"/>
 <TextBlock Text="Fictional local component examples. The caller accepts close requests and owns the original editable content." TextWrapping="Wrap"/>
 <TextBlock x:Name="Status" Text="No close requests"/>
 <o:BleeckerButton Content="Open bottom drawer" Size="Small" HorizontalAlignment="Left" Click="OpenDrawer"/>
 <StackPanel Orientation="Horizontal" Spacing="8"><o:BleeckerButton Content="Left sheet" Tag="Left" Size="Small" Click="OpenSheet"/><o:BleeckerButton Content="Right sheet" Tag="Right" Size="Small" Click="OpenSheet"/><o:BleeckerButton Content="Top sheet" Tag="Top" Size="Small" Click="OpenSheet"/><o:BleeckerButton Content="Bottom sheet" Tag="Bottom" Size="Small" Click="OpenSheet"/></StackPanel>
 <o:BleeckerButton Content="Open sheet with its own scroll control" Size="Small" Variant="Secondary" HorizontalAlignment="Left" Click="OpenOwnScroll"/>
 <o:BleeckerDrawer x:Name="Drawer" Title="Fictional drawer component" Description="The title and handle stay fixed while the original body scrolls." SurfaceStyle="{StaticResource BleeckerDrawerSurfaceStyle}" CloseRequested="Closed">
  <StackPanel Spacing="16"><TextBox Header="Fictional local note" Text="Original drawer value"/><o:BleeckerButton Content="Expand or shrink drawer content" Size="Small" Click="ResizeDrawer"/><TextBlock x:Name="DrawerDetail" Text="Short fictional detail" TextWrapping="Wrap" FontSize="16" LineHeight="24" LineStackingStrategy="BlockLineHeight"/><o:BleeckerPopover x:Name="DrawerPopover"><o:BleeckerPopover.Trigger><o:BleeckerButton Content="Edit owned fictional settings" Size="Small" Variant="Secondary"/></o:BleeckerPopover.Trigger><StackPanel Width="240" Spacing="12"><TextBlock Text="Fictional drawer-owned settings"/><TextBox Header="Retained local setting" Text="Original owned setting"/></StackPanel></o:BleeckerPopover><o:BleeckerButton Content="Open nested sheet" Size="Small" Variant="Secondary" Click="OpenNested"/><o:BleeckerSheet x:Name="Nested" Side="Right" Title="Nested fictional component" Description="The shared host handles only the top close request." CloseRequested="Closed"><TextBox Header="Nested local value" Text="Original nested editor"/></o:BleeckerSheet></StackPanel>
 </o:BleeckerDrawer>
 <o:BleeckerSheet x:Name="Sheet" Title="Fictional sheet component" Description="Choose any physical edge. The original editor survives close requests." SurfaceStyle="{StaticResource BleeckerSheetRightSurfaceStyle}" CloseRequested="Closed">
  <StackPanel Spacing="16"><TextBox Header="Fictional local note" Text="Original sheet value"/><o:BleeckerSelect x:Name="SheetSelect" Value="a" Width="240" HorizontalAlignment="Left" ValueRequested="ChoiceRequested" AutomationProperties.Name="Fictional owned choice"/><o:BleeckerButton Content="Fictional sheet help" Size="Small" Variant="Secondary"><o:BleeckerTooltipService.ToolTip><o:BleeckerTooltip x:Name="SheetTooltip" Content="Fictional sheet-owned guidance"/></o:BleeckerTooltipService.ToolTip></o:BleeckerButton><o:BleeckerButton Content="Expand or shrink sheet content" Size="Small" Click="ResizeSheet"/><TextBlock x:Name="SheetDetail" Text="Short fictional detail" TextWrapping="Wrap" FontSize="16" LineHeight="24" LineStackingStrategy="BlockLineHeight"/></StackPanel>
 </o:BleeckerSheet>
 <o:BleeckerSheet x:Name="LeftSheet" Side="Left" Title="Fictional left sheet" SurfaceStyle="{StaticResource BleeckerSheetLeftSurfaceStyle}" CloseRequested="Closed"><TextBox Header="Original left editor" Text="Fictional left value"/></o:BleeckerSheet>
 <o:BleeckerSheet x:Name="TopSheet" Side="Top" Title="Fictional top sheet" SurfaceStyle="{StaticResource BleeckerSheetTopSurfaceStyle}" CloseRequested="Closed"><TextBox Header="Original top editor" Text="Fictional top value"/></o:BleeckerSheet>
 <o:BleeckerSheet x:Name="BottomSheet" Side="Bottom" Title="Fictional bottom sheet" SurfaceStyle="{StaticResource BleeckerSheetBottomSurfaceStyle}" CloseRequested="Closed"><TextBox Header="Original bottom editor" Text="Fictional bottom value"/></o:BleeckerSheet>
 <o:BleeckerSheet x:Name="OwnScroll" Side="Left" ScrollContent="False" Title="Scroll-owning fictional content" Description="The caller supplies the scrolling control." SurfaceStyle="{StaticResource BleeckerSheetSurfaceStyle}" CloseRequested="Closed"><ScrollView VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"><StackPanel Height="1400" Spacing="20"><TextBox Header="Original retained editor" Text="Fictional scroll example"/><TextBlock Text="Fictional long component content"/><TextBlock Text="End of the fictional local content" VerticalAlignment="Bottom"/></StackPanel></ScrollView></o:BleeckerSheet>
</StackPanel>
