<UserControl x:Class="Orchard.Catalog.CurrencyChartsFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <StackPanel Spacing="16" Margin="0,0,0,24">
  <TextBlock Text="Currency chart" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
  <TextBlock Text="The fixed name/total Chart contract, with dollar ticks and native inspection." Style="{StaticResource BleeckerBodyStyle}" TextWrapping="Wrap" />
  <orchard:BleeckerChart x:Name="Specimen" Width="640" HorizontalAlignment="Left" AutomationProperties.Name="Fictional currency totals" />
 </StackPanel>
</UserControl>
