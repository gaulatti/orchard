<UserControl x:Class="Orchard.Catalog.ProgressStacksFixture"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <StackPanel Spacing="12">
  <TextBlock Text="Progress stacks" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
  <TextBlock Text="Consumer-owned segment values and brushes with a wrapping legend." Style="{StaticResource BleeckerBodyStyle}" />
  <orchard:BleeckerProgressStack x:Name="DefaultStack" Width="360" HorizontalAlignment="Left" AutomationProperties.Name="Publication distribution">
   <orchard:BleeckerProgressStack.Items>
    <orchard:BleeckerProgressStackItem Label="Published" Value="6" Color="#2c5784" />
    <orchard:BleeckerProgressStackItem Label="Draft" Value="3" Color="#bd7067" />
    <orchard:BleeckerProgressStackItem Label="Review" Value="1" Color="#b38b4d" />
   </orchard:BleeckerProgressStack.Items>
  </orchard:BleeckerProgressStack>
  <orchard:BleeckerProgressStack x:Name="PartialStack" Width="360" HorizontalAlignment="Left" />
  <orchard:BleeckerProgressStack x:Name="HiddenStack" Width="360" HorizontalAlignment="Left" ShowLegend="False" />
  <orchard:BleeckerProgressStack x:Name="WrappedStack" Width="160" HorizontalAlignment="Left" />
 </StackPanel>
</UserControl>
