<UserControl x:Class="Orchard.Catalog.IconButtonsFixture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:orchard="using:Orchard">
    <StackPanel Spacing="12">
        <TextBlock Text="Icon buttons" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
        <TextBlock Text="Each row: small, medium, large. Every icon has an accessible name and a tooltip."
                   Style="{StaticResource BleeckerBodyStyle}" />
        <TextBlock Text="Default" Style="{StaticResource BleeckerBodyStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <orchard:BleeckerIconButton Size="Small" AutomationProperties.Name="Search" ToolTipService.ToolTip="Search"><SymbolIcon Symbol="Find" /></orchard:BleeckerIconButton>
            <orchard:BleeckerIconButton x:Name="EditAction" AutomationProperties.Name="Edit story" ToolTipService.ToolTip="Edit story" CommandParameter="story"><SymbolIcon Symbol="Edit" /></orchard:BleeckerIconButton>
            <orchard:BleeckerIconButton Size="Large" AutomationProperties.Name="Add story" ToolTipService.ToolTip="Add story"><SymbolIcon Symbol="Add" /></orchard:BleeckerIconButton>
        </StackPanel>
        <TextBlock Text="Subtle" Style="{StaticResource BleeckerBodyStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <orchard:BleeckerIconButton Variant="Subtle" Size="Small" AutomationProperties.Name="Previous" ToolTipService.ToolTip="Previous"><SymbolIcon Symbol="Back" /></orchard:BleeckerIconButton>
            <orchard:BleeckerIconButton x:Name="SubtleAction" Variant="Subtle" AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Refresh"><SymbolIcon Symbol="Refresh" /></orchard:BleeckerIconButton>
            <orchard:BleeckerIconButton Variant="Subtle" Size="Large" AutomationProperties.Name="Next" ToolTipService.ToolTip="Next"><SymbolIcon Symbol="Forward" /></orchard:BleeckerIconButton>
        </StackPanel>
        <TextBlock Text="Ghost" Style="{StaticResource BleeckerBodyStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <orchard:BleeckerIconButton Variant="Ghost" Size="Small" AutomationProperties.Name="Close preview" ToolTipService.ToolTip="Close preview"><SymbolIcon Symbol="Cancel" /></orchard:BleeckerIconButton>
            <orchard:BleeckerIconButton x:Name="GhostAction" Variant="Ghost" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings"><SymbolIcon Symbol="Setting" /></orchard:BleeckerIconButton>
            <orchard:BleeckerIconButton Variant="Ghost" Size="Large" AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions"><SymbolIcon Symbol="More" /></orchard:BleeckerIconButton>
        </StackPanel>
        <orchard:BleeckerIconButton x:Name="DisabledAction" IsEnabled="False" AutomationProperties.Name="Delete unavailable" ToolTipService.ToolTip="Delete unavailable"><SymbolIcon Symbol="Delete" /></orchard:BleeckerIconButton>
        <TextBlock x:Name="Result" Text="No icon command yet" Style="{StaticResource BleeckerBodyStyle}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
