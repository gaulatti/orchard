<UserControl x:Class="Orchard.Catalog.IconButtonsFixture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:orchard="using:Orchard">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ReferenceIcons.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <StackPanel Spacing="12">
        <TextBlock Text="Icon buttons" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
        <TextBlock Text="Each row: small, medium, large. Every icon has an accessible name and a tooltip."
                   Style="{StaticResource BleeckerBodyStyle}" />
        <TextBlock Text="Default" Style="{StaticResource BleeckerBodyStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <orchard:BleeckerIconButton Size="Small" AutomationProperties.Name="Search" ToolTipService.ToolTip="Search"><ContentControl Style="{StaticResource LucideSearchIcon}" /></orchard:BleeckerIconButton>
            <orchard:BleeckerIconButton x:Name="EditAction" AutomationProperties.Name="Edit story" ToolTipService.ToolTip="Edit story" CommandParameter="story"><ContentControl Style="{StaticResource LucideEditIcon}" /></orchard:BleeckerIconButton>
            <orchard:BleeckerIconButton Size="Large" AutomationProperties.Name="Add story" ToolTipService.ToolTip="Add story"><ContentControl Style="{StaticResource LucideAddIcon}" /></orchard:BleeckerIconButton>
        </StackPanel>
        <TextBlock Text="Subtle" Style="{StaticResource BleeckerBodyStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <orchard:BleeckerIconButton Variant="Subtle" Size="Small" AutomationProperties.Name="Previous" ToolTipService.ToolTip="Previous"><ContentControl Style="{StaticResource LucidePreviousIcon}" /></orchard:BleeckerIconButton>
            <orchard:BleeckerIconButton x:Name="SubtleAction" Variant="Subtle" AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Refresh"><ContentControl Style="{StaticResource LucideRefreshIcon}" /></orchard:BleeckerIconButton>
            <orchard:BleeckerIconButton Variant="Subtle" Size="Large" AutomationProperties.Name="Next" ToolTipService.ToolTip="Next"><ContentControl Style="{StaticResource LucideNextIcon}" /></orchard:BleeckerIconButton>
        </StackPanel>
        <TextBlock Text="Ghost" Style="{StaticResource BleeckerBodyStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <orchard:BleeckerIconButton Variant="Ghost" Size="Small" AutomationProperties.Name="Close preview" ToolTipService.ToolTip="Close preview"><ContentControl Style="{StaticResource LucideCloseIcon}" /></orchard:BleeckerIconButton>
            <orchard:BleeckerIconButton x:Name="GhostAction" Variant="Ghost" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings"><ContentControl Style="{StaticResource LucideSettingsIcon}" /></orchard:BleeckerIconButton>
            <orchard:BleeckerIconButton Variant="Ghost" Size="Large" AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions"><ContentControl Style="{StaticResource LucideMoreIcon}" /></orchard:BleeckerIconButton>
        </StackPanel>
        <orchard:BleeckerIconButton x:Name="DisabledAction" IsEnabled="False" AutomationProperties.Name="Delete unavailable" ToolTipService.ToolTip="Delete unavailable"><ContentControl Style="{StaticResource LucideDeleteIcon}" /></orchard:BleeckerIconButton>
        <TextBlock x:Name="Result" Text="No icon command yet" Style="{StaticResource BleeckerBodyStyle}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
