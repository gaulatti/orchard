<UserControl x:Class="Orchard.Catalog.SkeletonsFixture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
    <StackPanel x:Name="Examples" Spacing="16">
        <Border x:Name="OpacitySource" Opacity="0.75" Visibility="Collapsed" />
        <TextBlock Text="Skeletons" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
        <TextBlock Text="Loading shapes · cards · tables" Style="{StaticResource BleeckerBodyStyle}" />
        <StackPanel x:Name="Shapes" Orientation="Horizontal" Spacing="16" Height="40">
            <orchard:BleeckerSkeleton x:Name="Rectangle" Width="240" Height="16" VerticalAlignment="Center" />
            <orchard:BleeckerSkeleton x:Name="Circle" Circle="True" Width="40" Height="40" />
            <orchard:BleeckerSkeleton x:Name="Capsule" Circle="True" Width="80" Height="40" />
        </StackPanel>
        <Grid ColumnSpacing="16" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
            <orchard:BleeckerSkeletonCard x:Name="DefaultCard" Width="320" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="16">
                <orchard:BleeckerSkeletonCard x:Name="ZeroCard" Width="320" Rows="{Binding Rows, ElementName=HeaderTable}" />
                <orchard:BleeckerSkeletonCard x:Name="TallCard" Width="320" Rows="6" />
            </StackPanel>
        </Grid>
        <Grid ColumnSpacing="16" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
            <orchard:BleeckerSkeletonTable x:Name="DefaultTable" Width="320" />
            <StackPanel Grid.Column="1" Spacing="16">
                <TextBlock Text="Header only · zero columns" Style="{StaticResource BleeckerBodyStyle}" />
                <orchard:BleeckerSkeletonTable x:Name="HeaderTable" Width="320" Rows="0" Columns="2" />
                <orchard:BleeckerSkeletonTable x:Name="EmptyColumns" Width="320" Columns="0" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
