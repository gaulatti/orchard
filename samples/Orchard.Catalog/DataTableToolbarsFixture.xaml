<UserControl x:Class="Orchard.Catalog.DataTableToolbarsFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <StackPanel Spacing="16">
  <TextBlock x:Name="Heading" Text="Data table toolbar" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
  <TextBlock Text="The original consumer table owns search, initial column filters, global filtering and its visible records." Style="{StaticResource BleeckerBodyStyle}" />
  <orchard:BleeckerDataTableToolbar x:Name="Preview" SearchColumn="title">
   <orchard:BleeckerDataTableToolbar.FilterRenderers><Button x:Name="Filter" Content="Status" Width="176" Height="36" Click="FilterClicked" /></orchard:BleeckerDataTableToolbar.FilterRenderers>
   <orchard:BleeckerDataTableToolbar.Actions><Button x:Name="Action" Content="New record" Width="104" Height="36" Click="ActionClicked" /></orchard:BleeckerDataTableToolbar.Actions>
  </orchard:BleeckerDataTableToolbar>
  <TextBlock x:Name="Results" Text="" Style="{StaticResource BleeckerBodyStyle}" AutomationProperties.LiveSetting="Polite" />
  <Button x:Name="Outside" Content="Outside toolbar" HorizontalAlignment="Left" />
  <Grid x:Name="Stage" />
 </StackPanel>
</UserControl>
