<UserControl x:Class="Orchard.Catalog.TimelinesFixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orchard="using:Orchard">
 <UserControl.Resources>
  <ControlTemplate x:Key="InlineIconTemplate" TargetType="Button"><ContentPresenter Content="{TemplateBinding Content}" /></ControlTemplate>
  <Style x:Key="InlineIconStyle" TargetType="Button"><Setter Property="Foreground" Value="{ThemeResource BleeckerTimelineOnStatusBrush}" /></Style>
 </UserControl.Resources>
 <StackPanel Spacing="16">
  <TextBlock Text="Timeline" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
  <TextBlock Text="Consumer-owned history · explicit status · responsive timestamps · original icon content" Style="{StaticResource BleeckerBodyStyle}" TextWrapping="Wrap" />
  <ComboBox x:Name="CasePicker" Width="280" Header="Source case" AutomationProperties.Name="Timeline source case" SelectionChanged="CaseChanged" />
  <Canvas x:Name="Frame" Width="1024" Height="900" HorizontalAlignment="Left" UseLayoutRounding="False">
   <orchard:BleeckerTimeline x:Name="Timeline" Canvas.Left="20" Canvas.Top="20" Width="640" AutomationProperties.Name="Editorial record history">
    <orchard:BleeckerTimeline.Items><orchard:BleeckerTimelineItem Id="created" Title="Record created" Description="Fictional local metadata" /></orchard:BleeckerTimeline.Items>
   </orchard:BleeckerTimeline>
  </Canvas>
 </StackPanel>
</UserControl>
