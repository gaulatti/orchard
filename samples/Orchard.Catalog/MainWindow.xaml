<Window
    x:Class="Orchard.Catalog.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:orchard="using:Orchard"
    xmlns:local="using:Orchard.Catalog"
    Title="orchard · Windows component catalog">
    <Grid x:Name="CatalogRoot" Background="{ThemeResource BleeckerBackgroundBrush}" Loaded="OnLoaded">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Grid.ColumnSpan="2" ColumnSpacing="24" Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="orchard" Style="{StaticResource BleeckerHeadingStyle}" />
                        <TextBlock Text="Gaulatti’s native Windows component library" Style="{StaticResource BleeckerBodyStyle}" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeSelector" Grid.Column="1" Header="Appearance" Width="160"
                              Style="{StaticResource BleeckerComboBoxStyle}" SelectionChanged="OnThemeChanged" SelectedIndex="0">
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </Grid>
        <Grid Grid.Row="1" Margin="16,0,16,16" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <orchard:BleeckerInput x:Name="ComponentSearch" PlaceholderText="Find a component" AutomationProperties.Name="Find a component" TextChanged="OnComponentSearchChanged" />
            <TextBlock x:Name="NavigationStatus" Grid.Row="1" Style="{StaticResource BleeckerBodyStyle}" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ComponentNavigation" Spacing="4" /></ScrollViewer>
        </Grid>
        <ScrollViewer x:Name="CatalogScroll" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="FixtureHost" MaxWidth="960" HorizontalAlignment="Stretch" Margin="24,0,24,24" Spacing="24">
                <StackPanel x:Name="Foundation" Spacing="24">
                <Border Background="{ThemeResource BleeckerMutedBrush}" BorderBrush="{ThemeResource BleeckerBorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource BleeckerCardCornerRadius}" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Typography" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
                        <TextBlock x:Name="HeadingSample" Text="Built for the newsroom." Style="{StaticResource BleeckerHeadingStyle}" />
                        <TextBlock Text="Encode Sans sets the headlines and controls. Libre Franklin gives longer passages room to breathe. These fonts are bundled with Orchard, so the catalog needs no font installation or network connection."
                                   Style="{StaticResource BleeckerBodyStyle}" />
                        <TextBlock Text="The same Bleecker palette, expressed through native Windows controls."
                                   Style="{StaticResource BleeckerBodyStyle}" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <StackPanel Spacing="12">
                    <TextBlock Text="Actions" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="PrimaryAction" Content="Primary action" Style="{StaticResource BleeckerPrimaryButtonStyle}" Click="OnPrimaryAction" />
                        <Button Content="Secondary action" Style="{StaticResource BleeckerSecondaryButtonStyle}" />
                        <Button x:Name="DisabledAction" Content="Unavailable" IsEnabled="False" Style="{StaticResource BleeckerPrimaryButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="ActionResult" Text="Ready" Style="{StaticResource BleeckerBodyStyle}" AutomationProperties.LiveSetting="Polite" />
                    <orchard:BleeckerButtonGroup x:Name="ActionGroup" HorizontalAlignment="Left" AutomationProperties.Name="View actions">
                        <Button Content="Overview" Style="{StaticResource BleeckerSecondaryButtonStyle}" Click="OnPrimaryAction" />
                        <Button Content="Details" Style="{StaticResource BleeckerSecondaryButtonStyle}" Click="OnPrimaryAction" />
                        <Button Content="Unavailable" IsEnabled="False" Style="{StaticResource BleeckerSecondaryButtonStyle}" />
                    </orchard:BleeckerButtonGroup>
                    <orchard:BleeckerButtonGroup Orientation="Vertical" HorizontalAlignment="Left" AutomationProperties.Name="Editorial actions">
                        <Button Content="Review" Style="{StaticResource BleeckerSecondaryButtonStyle}" />
                        <Button Content="Archive" Style="{StaticResource BleeckerSecondaryButtonStyle}" />
                    </orchard:BleeckerButtonGroup>
                </StackPanel>
                <StackPanel Spacing="12">
                    <TextBlock Text="Inputs" Style="{StaticResource BleeckerHeadingStyle}" FontSize="24" />
                    <TextBox x:Name="HeadlineInput" Header="Headline" PlaceholderText="Write a headline"
                             Style="{StaticResource BleeckerTextBoxStyle}" />
                    <TextBox Header="Summary" PlaceholderText="Write a short summary" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="100" Style="{StaticResource BleeckerTextBoxStyle}" />
                </StackPanel>
                </StackPanel>
                <local:TogglesFixture x:Name="Toggles" />
                <local:ButtonsFixture x:Name="Buttons" />
                <local:IconButtonsFixture x:Name="IconButtons" />
                <local:ToggleGroupsFixture x:Name="ToggleGroups" />
                <local:LoadingSpinnersFixture x:Name="LoadingSpinners" />
                <local:CardsFixture x:Name="Cards" />
                <local:SkeletonsFixture x:Name="Skeletons" />
                <local:SeparatorsFixture x:Name="Separators" />
                <local:StatusBadgesFixture x:Name="StatusBadges" />
                <local:MenusFixture x:Name="Menus" />
                <local:NotificationsFixture x:Name="Notifications" />
                <local:TooltipsFixture x:Name="Tooltips" />
                <local:FieldHelpFixture x:Name="FieldHelp" />
                <local:LabelsFixture x:Name="Labels" />
                <local:InputsFixture x:Name="Inputs" />
                <local:KeyboardFixture x:Name="Keyboard" />
                <local:EyebrowsFixture x:Name="Eyebrows" />
                <local:ProgressFixture x:Name="Progress" />
                <local:SwitchesFixture x:Name="Switches" />
                <local:CheckboxesFixture x:Name="Checkboxes" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
