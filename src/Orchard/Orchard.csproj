<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <RootNamespace>Orchard</RootNamespace>
        <UseWinUI>true</UseWinUI>
        <WinUISDKReferences>false</WinUISDKReferences>
        <Platforms>x64;ARM64</Platforms>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
        <IsPackable>true</IsPackable>
        <PackageId>Gaulatti.Orchard</PackageId>
        <Description>Gaulatti's native Windows component library.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="Text/SpecialCasing-17.0.0.txt" LogicalName="Orchard.Text.SpecialCasing-17.0.0.txt" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Graphics.Win2D" />
    </ItemGroup>
    <ItemGroup>
        <!-- Loose font files use the same URI paths for source and package consumers.
             Keeping them out of the library PRI avoids a second Orchard path prefix. -->
        <Content Remove="Assets/Fonts/*" />
        <None Remove="Assets/Fonts/*" />
        <None Include="Assets/Fonts/*.ttf" Pack="true" PackagePath="assets/fonts/%(Filename)%(Extension)">
            <Link>Orchard/Assets/Fonts/%(Filename)%(Extension)</Link>
            <TargetPath>Orchard/Assets/Fonts/%(Filename)%(Extension)</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="Assets/Fonts/OFL-*.txt" Pack="true" PackagePath="assets/fonts/%(Filename)%(Extension)">
            <Link>Orchard/Assets/Fonts/%(Filename)%(Extension)</Link>
            <TargetPath>Orchard/Assets/Fonts/%(Filename)%(Extension)</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="buildTransitive/Gaulatti.Orchard.targets" Pack="true" PackagePath="buildTransitive/" />
        <Content Remove="Assets/Images/*" />
        <None Remove="Assets/Images/*" />
        <None Include="Assets/Images/*.svg" Pack="true" PackagePath="assets/images/%(Filename)%(Extension)">
            <Link>Orchard/Assets/Images/%(Filename)%(Extension)</Link>
            <TargetPath>Orchard/Assets/Images/%(Filename)%(Extension)</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="../../docs/package-readme.md" Pack="true" PackagePath="README.md" />
        <None Include="../../tokens/LICENSE-Bleecker.txt" Pack="true" PackagePath="licenses/" />
        <None Include="../../licenses/LICENSE-Lucide.txt" Pack="true" PackagePath="licenses/" />
        <None Include="../../licenses/LICENSE-Radix.txt" Pack="true" PackagePath="licenses/" />
        <None Include="../../licenses/LICENSE-Unicode.txt" Pack="true" PackagePath="licenses/" />
        <None Include="../../licenses/LICENSE-D3-Shape.txt" Pack="true" PackagePath="licenses/" />
        <None Include="../../licenses/LICENSE-EsToolkit.txt" Pack="true" PackagePath="licenses/" />
        <None Include="../../licenses/LICENSE-Recharts.txt" Pack="true" PackagePath="licenses/" />
    </ItemGroup>
</Project>
