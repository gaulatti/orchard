<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="BleeckerPaginationScrollSeparatorBrush" Color="#FFFFFF" Opacity="0.1" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserFocusBrush" Color="#5BA3F5" />
      <SolidColorBrush x:Key="BleeckerPaginationOptionHighlightBrush" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserRingBrush" Color="#1F5BA3F5" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserBackgroundBrush" Color="#182533" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserDisabledBrush" Color="#182533" />
      <SolidColorBrush x:Key="BleeckerPaginationOptionBackgroundBrush" Color="#00FFFFFF" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserHoverBrush" Color="#40FFFFFF" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserBorderBrush" Color="#26FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BleeckerPaginationScrollSeparatorBrush" Color="#E6D5B8" Opacity="0.15" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserFocusBrush" Color="#B32C5784" />
      <SolidColorBrush x:Key="BleeckerPaginationOptionHighlightBrush" Color="#F9F6F2" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserRingBrush" Color="#1A2C5784" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserDisabledBrush" Color="#A6F9F6F2" />
      <SolidColorBrush x:Key="BleeckerPaginationOptionBackgroundBrush" Color="#00FFFFFF" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserHoverBrush" Color="#B3E6D5B8" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserBorderBrush" Color="#66E6D5B8" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="BleeckerPaginationScrollSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="BleeckerPaginationOptionHighlightBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserRingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserDisabledBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="BleeckerPaginationOptionBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="BleeckerPaginationChooserBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>