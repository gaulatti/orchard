<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ResourceDictionary.ThemeDictionaries>
<ResourceDictionary x:Key="Light">
<SolidColorBrush x:Key="BleeckerInputBackgroundBrush" Color="#FFFFFF" />
<SolidColorBrush x:Key="BleeckerInputBorderBrush" Color="#66E6D5B8" />
<SolidColorBrush x:Key="BleeckerInputHoverBrush" Color="#B3E6D5B8" />
<SolidColorBrush x:Key="BleeckerInputFocusBrush" Color="#B32C5784" />
<SolidColorBrush x:Key="BleeckerInputRingBrush" Color="#1A2C5784" />
<SolidColorBrush x:Key="BleeckerInputErrorBrush" Color="#A65D57" />
<SolidColorBrush x:Key="BleeckerInputErrorFocusBrush" Color="#A65D57" />
<SolidColorBrush x:Key="BleeckerInputErrorRingBrush" Color="#26A65D57" />
<SolidColorBrush x:Key="BleeckerInputPlaceholderBrush" Color="#8C595959" />
<SolidColorBrush x:Key="BleeckerInputDisabledBrush" Color="#A6F9F6F2" />
</ResourceDictionary>
<ResourceDictionary x:Key="Default">
<SolidColorBrush x:Key="BleeckerInputBackgroundBrush" Color="#182533" />
<SolidColorBrush x:Key="BleeckerInputBorderBrush" Color="#26FFFFFF" />
<SolidColorBrush x:Key="BleeckerInputHoverBrush" Color="#40FFFFFF" />
<SolidColorBrush x:Key="BleeckerInputFocusBrush" Color="#5BA3F5" />
<SolidColorBrush x:Key="BleeckerInputRingBrush" Color="#1F5BA3F5" />
<SolidColorBrush x:Key="BleeckerInputErrorBrush" Color="#D47B75" />
<SolidColorBrush x:Key="BleeckerInputErrorFocusBrush" Color="#5BA3F5" />
<SolidColorBrush x:Key="BleeckerInputErrorRingBrush" Color="#1F5BA3F5" />
<SolidColorBrush x:Key="BleeckerInputPlaceholderBrush" Color="#B8C5D6" />
<SolidColorBrush x:Key="BleeckerInputDisabledBrush" Color="#182533" />
</ResourceDictionary>
<ResourceDictionary x:Key="HighContrast">
<SolidColorBrush x:Key="BleeckerInputBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
<SolidColorBrush x:Key="BleeckerInputBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
<SolidColorBrush x:Key="BleeckerInputHoverBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
<SolidColorBrush x:Key="BleeckerInputFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
<SolidColorBrush x:Key="BleeckerInputRingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
<SolidColorBrush x:Key="BleeckerInputErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
<SolidColorBrush x:Key="BleeckerInputErrorFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
<SolidColorBrush x:Key="BleeckerInputErrorRingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
<SolidColorBrush x:Key="BleeckerInputPlaceholderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
<SolidColorBrush x:Key="BleeckerInputDisabledBrush" Color="{ThemeResource SystemColorWindowColor}" />
</ResourceDictionary>
</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

