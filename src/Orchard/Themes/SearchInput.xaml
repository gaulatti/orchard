<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light"><Style x:Key="SearchClearHoverPaletteStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource BleeckerSandBrush}" /><Setter Property="Opacity" Value=".10" /></Style></ResourceDictionary>
  <ResourceDictionary x:Key="Default"><Style x:Key="SearchClearHoverPaletteStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource BleeckerSandBrush}" /><Setter Property="Opacity" Value=".15" /></Style></ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast"><Style x:Key="SearchClearHoverPaletteStyle" TargetType="TextBlock"><Setter Property="Foreground"><Setter.Value><SolidColorBrush Color="{ThemeResource SystemColorHighlightColor}" /></Setter.Value></Setter><Setter Property="Opacity" Value="1" /></Style></ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style TargetType="local:BleeckerSearchInput">
  <Setter Property="IsTabStop" Value="False" /><Setter Property="UseLayoutRounding" Value="False" />
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerSearchInput"><Grid FlowDirection="LeftToRight">
   <Grid Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="PART_Secondary" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" /><TextBlock x:Name="PART_Hover" Foreground="{ThemeResource BleeckerTextPrimaryBrush}" /><TextBlock x:Name="PART_HoverBackground" Style="{ThemeResource SearchClearHoverPaletteStyle}" /></Grid>
   <Grid x:Name="PART_Content" />
  </Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
