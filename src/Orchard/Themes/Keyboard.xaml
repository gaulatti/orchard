<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="KbdBackground" Color="#F9F6F2" Opacity="0.5" />
            <SolidColorBrush x:Key="KbdBorder" Color="Black" Opacity="0.08" />
            <SolidColorBrush x:Key="KbdShadow" Color="Black" Opacity="0.08" />
            <SolidColorBrush x:Key="KbdForeground" Color="#595959" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="KbdBackground" Color="#182533" Opacity="0.5" />
            <SolidColorBrush x:Key="KbdBorder" Color="White" Opacity="0.1" />
            <SolidColorBrush x:Key="KbdShadow" Color="White" Opacity="0.1" />
            <SolidColorBrush x:Key="KbdForeground" Color="#F0F4F8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="KbdBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="KbdBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="KbdShadow" Color="Transparent" />
            <SolidColorBrush x:Key="KbdForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <FontFamily x:Key="BleeckerKeyboardFontFamily">Consolas</FontFamily>
</ResourceDictionary>
