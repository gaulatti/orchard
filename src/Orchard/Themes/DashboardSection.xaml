<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style TargetType="local:BleeckerDashboardSection">
  <Setter Property="IsTabStop" Value="False" /><Setter Property="UseSystemFocusVisuals" Value="False" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="UseLayoutRounding" Value="False" />
  <Setter Property="HighContrastAdjustment" Value="None" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Top" />
  <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerDashboardSection">
   <Border FlowDirection="{TemplateBinding FlowDirection}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
    <StackPanel x:Name="PART_Layout" Spacing="20">
     <Grid x:Name="PART_Header" Style="{TemplateBinding HeaderStyle}">
      <StackPanel x:Name="PART_Lead">
       <TextBlock x:Name="PART_Title" Text="{TemplateBinding Title}" Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource BleeckerPrimaryMediumFontFamily}" FontSize="18" FontWeight="Medium" LineHeight="28" LineStackingStrategy="BlockLineHeight" CharacterSpacing="-20" TextWrapping="WrapWholeWords" TextReadingOrder="UseFlowDirection" AutomationProperties.HeadingLevel="Level2" />
       <TextBlock x:Name="PART_Description" Text="{TemplateBinding Description}" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" FontFamily="{StaticResource BleeckerSecondaryFontFamily}" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Margin="0,4,0,0" TextWrapping="WrapWholeWords" TextReadingOrder="UseFlowDirection" />
      </StackPanel>
      <ContentPresenter x:Name="PART_Action" Content="{TemplateBinding Action}" ContentTemplate="{TemplateBinding ActionTemplate}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
     </Grid>
     <ContentPresenter x:Name="PART_Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
    </StackPanel>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
