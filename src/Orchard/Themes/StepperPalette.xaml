<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="BleeckerStepperSurfaceBrush" Color="#FFFFFF" />
   <SolidColorBrush x:Key="BleeckerStepperAccentBrush" Color="#2C5784" />
   <SolidColorBrush x:Key="BleeckerStepperOnAccentBrush" Color="#FFFFFF" />
   <SolidColorBrush x:Key="BleeckerStepperErrorBrush" Color="#A65D57" />
   <SolidColorBrush x:Key="BleeckerStepperPendingRingBrush" Color="#E6D5B8" Opacity=".3" />
   <SolidColorBrush x:Key="BleeckerStepperLineBrush" Color="#E6D5B8" Opacity=".2" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="Dark">
   <SolidColorBrush x:Key="BleeckerStepperSurfaceBrush" Color="#182533" />
   <SolidColorBrush x:Key="BleeckerStepperAccentBrush" Color="#5BA3F5" />
   <SolidColorBrush x:Key="BleeckerStepperOnAccentBrush" Color="#FFFFFF" />
   <SolidColorBrush x:Key="BleeckerStepperErrorBrush" Color="#D47B75" />
   <SolidColorBrush x:Key="BleeckerStepperPendingRingBrush" Color="#1A2332" Opacity=".3" />
   <SolidColorBrush x:Key="BleeckerStepperLineBrush" Color="#1A2332" Opacity=".2" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="BleeckerStepperSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
   <SolidColorBrush x:Key="BleeckerStepperAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
   <SolidColorBrush x:Key="BleeckerStepperOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
   <SolidColorBrush x:Key="BleeckerStepperErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
   <SolidColorBrush x:Key="BleeckerStepperPendingRingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
   <SolidColorBrush x:Key="BleeckerStepperLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
