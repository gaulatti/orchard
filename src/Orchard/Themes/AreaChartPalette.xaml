<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="BleeckerAreaCursorBrush" Color="#CCCCCC" /><SolidColorBrush x:Key="BleeckerAreaDotBorderBrush" Color="White" /></ResourceDictionary>
  <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="BleeckerAreaCursorBrush" Color="#CCCCCC" /><SolidColorBrush x:Key="BleeckerAreaDotBorderBrush" Color="White" /></ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="BleeckerAreaCursorBrush" Color="{ThemeResource SystemColorHighlightColor}" /><SolidColorBrush x:Key="BleeckerAreaDotBorderBrush" Color="{ThemeResource SystemColorWindowColor}" /></ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
