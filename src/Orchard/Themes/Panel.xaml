<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="PanelHeaderBackground" Color="White"/><SolidColorBrush x:Key="PanelHeaderBorder" Color="Black" Opacity="0.06"/>
   <SolidColorBrush x:Key="PanelRightBorder" Color="#E6D5B8" Opacity="0.2"/>
   <SolidColorBrush x:Key="PanelCountBackground" Color="#F9F6F2" Opacity="0.4"/><SolidColorBrush x:Key="PanelCountBorder" Color="#E6D5B8" Opacity="0.3"/>
   <SolidColorBrush x:Key="PanelToolbarBackground" Color="#F9F6F2" Opacity="0.2"/><SolidColorBrush x:Key="PanelToolbarBorder" Color="#E6D5B8" Opacity="0.2"/>
   <SolidColorBrush x:Key="PanelFeedBackground" Color="#F9F6F2" Opacity="0.1"/>
   <SolidColorBrush x:Key="PanelHandleIdle" Color="Black" Opacity="0.4"/><SolidColorBrush x:Key="PanelHandleHover" Color="Black" Opacity="0.8"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="PanelHeaderBackground" Color="#182533"/><SolidColorBrush x:Key="PanelHeaderBorder" Color="White" Opacity="0.08"/>
   <SolidColorBrush x:Key="PanelRightBorder" Color="White" Opacity="0.06"/>
   <SolidColorBrush x:Key="PanelCountBackground" Color="White" Opacity="0.05"/><SolidColorBrush x:Key="PanelCountBorder" Color="White" Opacity="0.1"/>
   <SolidColorBrush x:Key="PanelToolbarBackground" Color="White" Opacity="0.03"/><SolidColorBrush x:Key="PanelToolbarBorder" Color="White" Opacity="0.06"/>
   <SolidColorBrush x:Key="PanelFeedBackground" Color="#00000000"/>
   <SolidColorBrush x:Key="PanelHandleIdle" Color="White" Opacity="0.4"/><SolidColorBrush x:Key="PanelHandleHover" Color="White" Opacity="0.8"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="PanelHeaderBackground" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="PanelHeaderBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="PanelRightBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="PanelCountBackground" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="PanelCountBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="PanelToolbarBackground" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="PanelToolbarBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="PanelFeedBackground" Color="{ThemeResource SystemColorWindowColor}"/>
   <SolidColorBrush x:Key="PanelHandleIdle" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="PanelHandleHover" Color="{ThemeResource SystemColorHighlightColor}"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style TargetType="local:BleeckerPanel">
  <Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="BorderThickness" Value="2,0,1,0"/><Setter Property="BorderBrush" Value="{ThemeResource PanelRightBorder}"/>
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerPanel">
   <Grid x:Name="PART_ClipRoot" Background="{TemplateBinding Background}" FlowDirection="LeftToRight" UseLayoutRounding="False">
    <Grid x:Name="PART_Root" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}" UseLayoutRounding="False"/>
    <Border x:Name="PART_LeftAccent" HorizontalAlignment="Left" IsHitTestVisible="False" UseLayoutRounding="False"/>
    <TextBlock x:Name="PART_AccentSource" Visibility="Collapsed" Foreground="{ThemeResource BleeckerSeaBrush}"/>
    <TextBlock x:Name="PART_HandleIdleSource" Visibility="Collapsed" Foreground="{ThemeResource PanelHandleIdle}"/>
    <TextBlock x:Name="PART_HandleHoverSource" Visibility="Collapsed" Foreground="{ThemeResource PanelHandleHover}"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
