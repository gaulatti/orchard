<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orchard">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/Inputs.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/Keyboard.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/Eyebrow.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/Progress.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/Cards/Surface.g.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/StatusBadges/Default.g.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="local:BleeckerInput" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" />
        <Setter Property="FontWeight" Value="Normal" /><Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="Background" Value="{ThemeResource BleeckerInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BleeckerInputBorderBrush}" />
        <Setter Property="PlaceholderForeground" Value="{ThemeResource BleeckerInputPlaceholderBrush}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextReadingOrder" Value="UseFlowDirection" />
        <Setter Property="TextAlignment" Value="Start" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerInput">
            <Grid FlowDirection="LeftToRight">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Focused" /><VisualState x:Name="Disabled" /></VisualStateGroup>
                    <VisualStateGroup x:Name="InputStates">
                        <VisualState x:Name="InputNormal" />
                        <VisualState x:Name="InputHovered"><VisualState.Setters><Setter Target="InputPalette.BorderBrush" Value="{ThemeResource BleeckerInputHoverBrush}" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="InputFocused"><VisualState.Setters>
                            <Setter Target="InputPalette.BorderBrush" Value="{ThemeResource BleeckerInputFocusBrush}" /><Setter Target="InputRingPalette.Opacity" Value="1" />
                        </VisualState.Setters></VisualState>
                        <VisualState x:Name="InputNormalError"><VisualState.Setters><Setter Target="InputPalette.BorderBrush" Value="{ThemeResource BleeckerInputErrorBrush}" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="InputHoveredError"><VisualState.Setters><Setter Target="InputPalette.BorderBrush" Value="{ThemeResource BleeckerInputHoverBrush}" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="InputFocusedError"><VisualState.Setters>
                            <Setter Target="InputPalette.BorderBrush" Value="{ThemeResource BleeckerInputErrorFocusBrush}" />
                            <Setter Target="InputRingPalette.BorderBrush" Value="{ThemeResource BleeckerInputErrorRingBrush}" /><Setter Target="InputRingPalette.Opacity" Value="1" />
                        </VisualState.Setters></VisualState>
                        <VisualState x:Name="InputDisabled"><VisualState.Setters>
                            <Setter Target="InputPalette.Opacity" Value="0.6" /><Setter Target="InputPalette.Background" Value="{ThemeResource BleeckerInputDisabledBrush}" />
                        </VisualState.Setters></VisualState>
                        <VisualState x:Name="InputDisabledError"><VisualState.Setters>
                            <Setter Target="InputPalette.Opacity" Value="0.6" /><Setter Target="InputPalette.Background" Value="{ThemeResource BleeckerInputDisabledBrush}" />
                            <Setter Target="InputPalette.BorderBrush" Value="{ThemeResource BleeckerInputErrorBrush}" />
                        </VisualState.Setters></VisualState>
                        <VisualState x:Name="InputDisabledHovered"><VisualState.Setters>
                            <Setter Target="InputPalette.Opacity" Value="0.6" /><Setter Target="InputPalette.Background" Value="{ThemeResource BleeckerInputDisabledBrush}" />
                            <Setter Target="InputPalette.BorderBrush" Value="{ThemeResource BleeckerInputHoverBrush}" />
                        </VisualState.Setters></VisualState>
                        <VisualState x:Name="InputDisabledHoveredError"><VisualState.Setters>
                            <Setter Target="InputPalette.Opacity" Value="0.6" /><Setter Target="InputPalette.Background" Value="{ThemeResource BleeckerInputDisabledBrush}" />
                            <Setter Target="InputPalette.BorderBrush" Value="{ThemeResource BleeckerInputHoverBrush}" />
                        </VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Visibility="Collapsed" />
                <Border x:Name="InputPalette" Visibility="Collapsed" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                <Border x:Name="InputRingPalette" Visibility="Collapsed" BorderBrush="{ThemeResource BleeckerInputRingBrush}" Opacity="0" />
                <Grid x:Name="Editor" Grid.Row="1" MinHeight="{TemplateBinding MinHeight}">
                    <Canvas Opacity="0" IsHitTestVisible="False">
                        <Path x:Name="InputShadowMask" Fill="White" /><Path x:Name="InputShadowExteriorMask" Fill="White" />
                        <TextBlock x:Name="InputFontMetrics" Text="Hg" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}" FontStyle="{TemplateBinding FontStyle}" FontStretch="{TemplateBinding FontStretch}"
                            IsTextScaleFactorEnabled="{TemplateBinding IsTextScaleFactorEnabled}" AutomationProperties.AccessibilityView="Raw" />
                    </Canvas>
                    <Grid x:Name="InputShadowHost" IsHitTestVisible="False" />
                    <Border x:Name="InputRing" Margin="-2" BorderThickness="2" CornerRadius="9" BorderBrush="{ThemeResource BleeckerInputRingBrush}" Opacity="0" IsHitTestVisible="False" />
                    <Border x:Name="BorderElement" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                    <Grid x:Name="InputTextViewport" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ScrollViewer x:Name="ContentElement" FlowDirection="{TemplateBinding FlowDirection}"
                        FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" CharacterSpacing="{TemplateBinding CharacterSpacing}"
                        Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden" IsTabStop="False" ZoomMode="Disabled" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="PlaceholderTextContentPresenter" FlowDirection="{TemplateBinding FlowDirection}"
                        FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" CharacterSpacing="{TemplateBinding CharacterSpacing}"
                        Text="{TemplateBinding PlaceholderText}" TextReadingOrder="{TemplateBinding TextReadingOrder}" TextAlignment="{TemplateBinding TextAlignment}"
                        Foreground="{TemplateBinding PlaceholderForeground}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
                <ContentPresenter x:Name="StartAdornment" Grid.Row="1" Content="{TemplateBinding StartIcon}" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <ContentPresenter x:Name="EndAdornment" Grid.Row="1" Content="{TemplateBinding EndIcon}" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <ContentPresenter x:Name="DescriptionPresenter" Grid.Row="2" Content="{TemplateBinding Description}" AutomationProperties.AccessibilityView="Raw" x:Load="False" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerProgress">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}" />
        <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource ProgressFill}" />
        <Setter Property="Background" Value="{ThemeResource ProgressTrack}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerProgress">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="PART_Track" CornerRadius="999" Background="{TemplateBinding Background}" VerticalAlignment="Center">
                    <Border x:Name="PART_Fill" CornerRadius="999" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                </Border>
                <TextBlock x:Name="PART_Label" Grid.Column="1" Margin="12,0,0,0" MinWidth="40" VerticalAlignment="Center" TextAlignment="Right"
                    FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                    LineHeight="16" LineStackingStrategy="BlockLineHeight"
                    Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource ProgressLabel}" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerEyebrow">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimarySemiboldFontFamily}" />
        <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{ThemeResource EyebrowForeground}" />
        <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerEyebrow">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="PART_Rule" Width="28" Height="1" Margin="0,0,12,0" VerticalAlignment="Center"
                    Background="{TemplateBinding Foreground}" Opacity="0.6" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="PART_Text" Grid.Column="1" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                    FontWeight="{TemplateBinding FontWeight}" CharacterSpacing="{TemplateBinding CharacterSpacing}" Foreground="{TemplateBinding Foreground}"
                    LineHeight="16" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                <ContentPresenter x:Name="PART_Content" Grid.Column="1" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                    FontWeight="{TemplateBinding FontWeight}" CharacterSpacing="{TemplateBinding CharacterSpacing}" Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerKbd">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Height" Value="20" /><Setter Property="MinWidth" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerKeyboardFontFamily}" />
        <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource KbdForeground}" />
        <Setter Property="Background" Value="{ThemeResource KbdBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource KbdBorder}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerKbd">
            <Grid>
                <Grid x:Name="PART_Single">
                    <Canvas IsHitTestVisible="False"><Path x:Name="PART_Shadow" Fill="{ThemeResource KbdShadow}" /></Canvas>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </Grid>
                <StackPanel x:Name="PART_Combination" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                <TextBlock x:Name="PART_SeparatorPalette" Visibility="Collapsed" Foreground="{ThemeResource BleeckerTextSecondaryBrush}"
                    FontFamily="{StaticResource BleeckerPrimaryFontFamily}" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerLabel">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}" />
        <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerLabel">
            <Grid x:Name="LabelRoot" Background="Transparent">
                <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="LabelRoot.Opacity" Value="0.6" /></VisualState.Setters></VisualState>
                </VisualStateGroup></VisualStateManager.VisualStateGroups>
                <TextBlock x:Name="PART_Text" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                    CharacterSpacing="{TemplateBinding CharacterSpacing}" Foreground="{TemplateBinding Foreground}"
                    LineHeight="13" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                <ContentPresenter x:Name="PART_Content" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerFieldHelpTooltip">
        <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextSecondaryBrush}" />
        <Setter Property="PointerOverForeground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerFieldHelpTooltip">
            <Grid x:Name="HelpRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="HelpScale" /></Grid.RenderTransform>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver" />
                        <VisualState x:Name="Pressed" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Unfocused" /><VisualState x:Name="PointerFocused" />
                        <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="HelpFocus.Opacity" Value="1" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Ellipse x:Name="HelpFocus" Width="20" Height="20" Margin="-2" Stroke="{ThemeResource BleeckerAccentBlueBrush}" StrokeThickness="2" Opacity="0" IsHitTestVisible="False" />
                <!-- Lucide Info, 24-unit source scaled to the reference 14px footprint. -->
                <Viewbox x:Name="InfoGlyph" Width="14" Height="14" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <Ellipse x:Name="InfoCircle" Canvas.Left="1" Canvas.Top="1" Width="22" Height="22" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" />
                        <Path x:Name="InfoMark" Data="M12,16 L12,12 M12,8 L12.01,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerTooltip">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" />
        <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTooltipForegroundBrush}" />
        <Setter Property="Background" Value="{ThemeResource BleeckerTooltipBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" /><Setter Property="MaxWidth" Value="229" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerTooltip">
            <Grid x:Name="PART_MotionRoot" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                <local:BleeckerOverlaySurface x:Name="PART_Surface" MaxWidth="224" Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}" AutomationProperties.AccessibilityView="Raw">
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" LineHeight="19.5" LineStackingStrategy="BlockLineHeight" />
                </local:BleeckerOverlaySurface>
                <Polygon x:Name="PART_Arrow" Fill="{TemplateBinding Background}" IsHitTestVisible="False" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerMenuContentItem" BasedOn="{StaticResource BleeckerMenuContentItemStyle}" />
    <Style TargetType="local:BleeckerMenuLabel">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="IsTabStop" Value="False" /><Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimarySemiboldFontFamily}" />
        <Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" /><Setter Property="Foreground" Value="{ThemeResource BleeckerTextSecondaryBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerMenuLabel">
            <Grid Padding="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="PART_Inset" Width="0" />
                <TextBlock x:Name="PART_Text" Grid.Column="1" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                    FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" CharacterSpacing="{TemplateBinding CharacterSpacing}"
                    LineHeight="15" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerOverlaySurface">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" /><Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource BleeckerMenuBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BleeckerMenuBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource BleeckerUiCornerRadius}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerOverlaySurface">
            <Grid>
                <Canvas IsHitTestVisible="False"><Path x:Name="PART_NearMask" Fill="{TemplateBinding Background}" /><Path x:Name="PART_FarMask" Fill="{TemplateBinding Background}" /></Canvas>
                <Grid x:Name="PART_ShadowHost" IsHitTestVisible="False" />
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerStatusBadge">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimarySemiboldFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{ThemeResource StatusBadgeBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StatusBadgeBorder}" />
        <Setter Property="Foreground" Value="{ThemeResource StatusBadgeForeground}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerStatusBadge">
            <Grid x:Name="PART_Layout">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="PART_Badge" MinHeight="24" Padding="10,2" CornerRadius="6" BorderThickness="1" VerticalAlignment="Center"
                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                    <Grid x:Name="PART_BadgeContent" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Ellipse x:Name="PART_Dot" Width="6" Height="6" Fill="{ThemeResource StatusBadgeDot}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PART_Label" Grid.Column="1" Text="{TemplateBinding Label}" FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}"
                                   FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" LineHeight="16.5" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <TextBlock x:Name="PART_Description" Grid.Column="1" Margin="8,0,0,0" Text="{TemplateBinding Description}" VerticalAlignment="Center"
                           FontFamily="{StaticResource BleeckerPrimaryFontFamily}" FontWeight="Normal" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                           Foreground="{ThemeResource BleeckerTextSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerSeparator">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{ThemeResource BleeckerSeparatorBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerSeparator">
            <Border Background="{TemplateBinding Background}" />
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerCard">
        <Setter Property="Background" Value="{ThemeResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerCardCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerCard">
            <Grid>
                <Canvas IsHitTestVisible="False">
                    <Path x:Name="PART_NearMask" Fill="{TemplateBinding Background}" />
                    <Path x:Name="PART_FarMask" Fill="{TemplateBinding Background}" />
                </Canvas>
                <Grid x:Name="PART_ShadowHost" IsHitTestVisible="False" />
                <Border x:Name="PART_Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerLoadingSpinner">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerPrimaryBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerLoadingSpinner">
            <Canvas x:Name="PART_Canvas">
                <Canvas.RenderTransform><RotateTransform /></Canvas.RenderTransform>
                <Path x:Name="PART_Arc" Stroke="{TemplateBinding Foreground}" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" />
            </Canvas>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="local:BleeckerToggleGroup">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource BleeckerToggleGroupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BleeckerToggleGroupBorderBrush}" />
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:BleeckerToggleGroup">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled" IsTabStop="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:BleeckerButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerButtonCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:BleeckerButton">
                    <Button x:Name="PART_Action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="{TemplateBinding BorderThickness}"
                            Command="{TemplateBinding Command}" CommandParameter="{TemplateBinding CommandParameter}"
                            AutomationProperties.HelpText="{TemplateBinding AutomationProperties.HelpText}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ProgressRing x:Name="PART_Progress" Width="16" Height="16" MinWidth="0" MinHeight="0"
                                          IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"
                                          Foreground="{Binding Foreground, ElementName=PART_Action}"
                                          AutomationProperties.AccessibilityView="Raw">
                                <ProgressRing.Template>
                                    <ControlTemplate TargetType="ProgressRing">
                                        <Viewbox Width="16" Height="16">
                                            <Grid Width="24" Height="24">
                                                <!-- Lucide LoaderCircle 0.563.0; see licenses/LICENSE-Lucide.txt. -->
                                                <Path x:Name="PART_SpinnerPath" Data="M21 12a9 9 0 1 1-6.219-8.56"
                                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                    <Path.RenderTransform><RotateTransform CenterX="12" CenterY="12" /></Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Viewbox>
                                    </ControlTemplate>
                                </ProgressRing.Template>
                            </ProgressRing>
                            <ContentPresenter x:Name="PART_Content" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center" />
                            <Border x:Name="PART_LinkUnderline" Grid.Column="1" Height="1" VerticalAlignment="Bottom"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Button>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
