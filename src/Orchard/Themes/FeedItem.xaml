<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="FeedItemBorder" Color="#E6D5B8" Opacity=".2"/><SolidColorBrush x:Key="FeedItemHover" Color="#F9F6F2" Opacity=".35"/>
   <SolidColorBrush x:Key="FeedItemAvatarRing" Color="Black" Opacity=".05"/>
   <SolidColorBrush x:Key="FeedItemRelevanceBackground" Color="#2C5784" Opacity=".06"/><SolidColorBrush x:Key="FeedItemRelevanceBorder" Color="#2C5784" Opacity=".1"/>
   <SolidColorBrush x:Key="FeedItemLanguageBackground" Color="#E6D5B8" Opacity=".25"/>
   <SolidColorBrush x:Key="FeedItemCategoryBackground" Color="#F9F6F2" Opacity=".6"/><SolidColorBrush x:Key="FeedItemCategoryBorder" Color="#E6D5B8" Opacity=".2"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="FeedItemBorder" Color="White" Opacity=".07"/><SolidColorBrush x:Key="FeedItemHover" Color="White" Opacity=".03"/>
   <SolidColorBrush x:Key="FeedItemAvatarRing" Color="White" Opacity=".1"/>
   <SolidColorBrush x:Key="FeedItemRelevanceBackground" Color="#5BA3F5" Opacity=".06"/><SolidColorBrush x:Key="FeedItemRelevanceBorder" Color="#5BA3F5" Opacity=".1"/>
   <SolidColorBrush x:Key="FeedItemLanguageBackground" Color="White" Opacity=".07"/>
   <SolidColorBrush x:Key="FeedItemCategoryBackground" Color="White" Opacity=".04"/><SolidColorBrush x:Key="FeedItemCategoryBorder" Color="White" Opacity=".07"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style TargetType="local:BleeckerFeedItem">
  <Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="Padding" Value="16"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{ThemeResource FeedItemBorder}"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/>
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerFeedItem">
   <Grid UseLayoutRounding="False">
    <Border x:Name="PART_Surface" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}" BackgroundSizing="OuterBorderEdge" UseLayoutRounding="False"><Grid x:Name="PART_Root" UseLayoutRounding="False"/></Border>
    <TextBlock x:Name="PART_HoverSource" Visibility="Collapsed" Foreground="{ThemeResource FeedItemHover}"/>
    <TextBlock x:Name="PART_LinkSource" Visibility="Collapsed" Foreground="{ThemeResource BleeckerSeaBrush}"/>
    <TextBlock x:Name="PART_LinkHoverSource" Visibility="Collapsed" Foreground="{ThemeResource BleeckerSeaBrush}"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
