<!-- Generated Bleecker Secondary native button palette; do not edit. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFFFF" Opacity="1" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FF2D2D2D" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFE6D5B8" Opacity="0.45" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF9F6F2" Opacity="0.35" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF2D2D2D" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFE6D5B8" Opacity="0.75" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFF9F6F2" Opacity="0.35" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF2D2D2D" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFE6D5B8" Opacity="0.75" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FFFFFFFF" Opacity="0.45" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF2D2D2D" Opacity="0.45" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FFE6D5B8" Opacity="0.2025" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ButtonBackground" Color="#FF182533" Opacity="1" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFF0F4F8" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFFFFFFF" Opacity="0.18" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFFFFF" Opacity="0.06" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFF0F4F8" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFFFFFFF" Opacity="0.18" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFFFFFFF" Opacity="0.06" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFF0F4F8" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFFFFFFF" Opacity="0.18" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF182533" Opacity="0.45" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FFF0F4F8" Opacity="0.45" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FFFFFFFF" Opacity="0.081" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorWindowColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorWindowColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorWindowColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource SystemColorWindowColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}" Opacity="1" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerButtonCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
