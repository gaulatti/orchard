<!-- Generated Bleecker Link native button palette; do not edit. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonFocusRingBrush" Color="#FF2C5784" Opacity="0.35" />
            <SolidColorBrush x:Key="ButtonBackground" Color="#FF2C5784" Opacity="0" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FF2C5784" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF2C5784" Opacity="0" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF2C5784" Opacity="0" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF1A374D" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF2C5784" Opacity="0" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF2C5784" Opacity="0" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF1A374D" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF2C5784" Opacity="0" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF2C5784" Opacity="0" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF2C5784" Opacity="0.45" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FF2C5784" Opacity="0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ButtonFocusRingBrush" Color="#FF5BA3F5" Opacity="0.45" />
            <SolidColorBrush x:Key="ButtonBackground" Color="#FF5BA3F5" Opacity="0" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FF5BA3F5" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF5BA3F5" Opacity="0" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF5BA3F5" Opacity="0" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF0D1821" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF5BA3F5" Opacity="0" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF5BA3F5" Opacity="0" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF0D1821" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF5BA3F5" Opacity="0" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF5BA3F5" Opacity="0" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF5BA3F5" Opacity="0.45" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FF5BA3F5" Opacity="0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ButtonFocusRingBrush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorWindowColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorWindowColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorWindowColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource SystemColorWindowColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" Opacity="1" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}" Opacity="1" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ButtonFocusRingBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource BleeckerFocusOffsetBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerButtonCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
