<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="AdminShellFooterBorderBrush" Color="Black" Opacity="0.08"/></ResourceDictionary>
  <ResourceDictionary x:Key="Default"><SolidColorBrush x:Key="AdminShellFooterBorderBrush" Color="White" Opacity="0.08"/></ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="AdminShellFooterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/></ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style TargetType="local:BleeckerAdminShell">
  <Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="VerticalAlignment" Value="Top"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="FontSize" Value="16"/>
  <Setter Property="Background" Value="{ThemeResource BleeckerBackgroundBrush}"/><Setter Property="Foreground" Value="{ThemeResource BleeckerForegroundBrush}"/>
  <Setter Property="ContentBackground" Value="{ThemeResource BleeckerBackgroundBrush}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerAdminShell">
   <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" UseLayoutRounding="False"><Grid x:Name="PART_Layout" UseLayoutRounding="False"/></Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
