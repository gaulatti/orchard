<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="RowBackground" Color="Transparent"/><SolidColorBrush x:Key="RowHover" Color="#F9F6F2"/></ResourceDictionary>
  <ResourceDictionary x:Key="Default"><SolidColorBrush x:Key="RowBackground" Color="Transparent"/><SolidColorBrush x:Key="RowHover" Color="White" Opacity="0.07"/></ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="RowBackground" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="RowHover" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="RowHoverForeground" Color="{ThemeResource SystemColorHighlightTextColor}"/></ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
