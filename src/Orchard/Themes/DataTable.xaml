<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Orchard/Themes/DataTablePalette.g.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style x:Key="BleeckerDataTableHeaderStyle" TargetType="local:BleeckerTableHeader" BasedOn="{StaticResource BleeckerTableHeaderStyle}"><Setter Property="Background" Value="{ThemeResource BleeckerDataTableHeaderFill}"/></Style>
 <Style x:Key="BleeckerDataTableStyle" TargetType="local:BleeckerDataTable">
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/><Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="Background" Value="{ThemeResource BleeckerTableCardFill}"/><Setter Property="BorderBrush" Value="{ThemeResource BleeckerDataTableCardStroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource BleeckerCardCornerRadius}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerDataTable"><StackPanel Spacing="16" UseLayoutRounding="False">
   <TextBlock x:Name="PART_Secondary" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" Visibility="Collapsed"/>
   <Grid x:Name="PART_SearchHost" HorizontalAlignment="Left"><local:BleeckerInput x:Name="PART_Search" MinWidth="0" InputSize="Medium"/></Grid>
   <Grid UseLayoutRounding="False">
    <Grid x:Name="PART_ShadowNear" FlowDirection="LeftToRight" IsHitTestVisible="False"/><Grid x:Name="PART_ShadowFar" FlowDirection="LeftToRight" IsHitTestVisible="False"/>
    <Canvas FlowDirection="LeftToRight" Opacity="0" IsHitTestVisible="False"><Path x:Name="PART_MaskNear" Fill="White"/><Path x:Name="PART_ExteriorNear" Fill="White"/><Path x:Name="PART_MaskFar" Fill="White"/><Path x:Name="PART_ExteriorFar" Fill="White"/></Canvas>
    <Border x:Name="PART_Surface" Background="{TemplateBinding Background}" BackgroundSizing="OuterBorderEdge" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" UseLayoutRounding="False"><Grid x:Name="PART_TableHost"/></Border>
   </Grid>
   <Grid Margin="8,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="PART_Summary" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" UseLayoutRounding="False"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="PART_Previous" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" UseLayoutRounding="False"/><Button x:Name="PART_Next" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" UseLayoutRounding="False"/></StackPanel>
   </Grid>
  </StackPanel></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="local:BleeckerDataTable" BasedOn="{StaticResource BleeckerDataTableStyle}"/>
</ResourceDictionary>
