<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="BleeckerTimelineCompletedBrush" Color="#2C5784" /><SolidColorBrush x:Key="BleeckerTimelineActiveBrush" Color="#C1814D" />
   <SolidColorBrush x:Key="BleeckerTimelinePendingBrush" Color="#E6D5B8" Opacity=".2" /><SolidColorBrush x:Key="BleeckerTimelineErrorBrush" Color="#A65D57" />
   <SolidColorBrush x:Key="BleeckerTimelineOnStatusBrush" Color="White" /><SolidColorBrush x:Key="BleeckerTimelineLineBrush" Color="#E6D5B8" Opacity=".2" />
   <SolidColorBrush x:Key="BleeckerTimelineBorderBrush" Color="White" Opacity=".5" /><SolidColorBrush x:Key="BleeckerTimelineShadowBrush" Color="#1A374D" Opacity=".08" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="BleeckerTimelineCompletedBrush" Color="#5BA3F5" /><SolidColorBrush x:Key="BleeckerTimelineActiveBrush" Color="#D4AF37" />
   <SolidColorBrush x:Key="BleeckerTimelinePendingBrush" Color="#1A2332" Opacity=".2" /><SolidColorBrush x:Key="BleeckerTimelineErrorBrush" Color="#D47B75" />
   <SolidColorBrush x:Key="BleeckerTimelineOnStatusBrush" Color="White" /><SolidColorBrush x:Key="BleeckerTimelineLineBrush" Color="#1A2332" Opacity=".2" />
   <SolidColorBrush x:Key="BleeckerTimelineBorderBrush" Color="White" Opacity=".1" /><SolidColorBrush x:Key="BleeckerTimelineShadowBrush" Color="#1A374D" Opacity=".08" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="BleeckerTimelineCompletedBrush" Color="{ThemeResource SystemColorHighlightColor}" /><SolidColorBrush x:Key="BleeckerTimelineActiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
   <SolidColorBrush x:Key="BleeckerTimelinePendingBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="BleeckerTimelineErrorBrush" Color="{ThemeResource SystemColorHighlightColor}" />
   <SolidColorBrush x:Key="BleeckerTimelineOnStatusBrush" Color="{ThemeResource SystemColorHighlightTextColor}" /><SolidColorBrush x:Key="BleeckerTimelineLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
   <SolidColorBrush x:Key="BleeckerTimelineBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" /><SolidColorBrush x:Key="BleeckerTimelineShadowBrush" Color="Transparent" />
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
