<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style x:Key="BleeckerFileInputStyle" TargetType="local:BleeckerFileInput">
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="FontSize" Value="14"/>
  <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/><Setter Property="Background" Value="{ThemeResource BleeckerFileBackgroundBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource BleeckerFileBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8"/><Setter Property="CornerRadius" Value="7"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="UseSystemFocusVisuals" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerFileInput">
   <Grid x:Name="FileRoot" UseLayoutRounding="False" Background="Transparent">
    <VisualStateManager.VisualStateGroups>
     <VisualStateGroup x:Name="FileStates">
      <VisualState x:Name="FileEnabled"/>
      <VisualState x:Name="FileHovered"><VisualState.Setters><Setter Target="FileChooseChrome.Background" Value="{ThemeResource BleeckerFileChooseHoverBrush}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="FileDisabled"><VisualState.Setters><Setter Target="FileRoot.Opacity" Value=".5"/></VisualState.Setters></VisualState>
      <VisualState x:Name="FileDisabledHovered"><VisualState.Setters><Setter Target="FileRoot.Opacity" Value=".5"/><Setter Target="FileChooseChrome.Background" Value="{ThemeResource BleeckerFileChooseHoverBrush}"/></VisualState.Setters></VisualState>
     </VisualStateGroup>
     <VisualStateGroup x:Name="FileValidationStates"><VisualState x:Name="FileNormal"/><VisualState x:Name="FileError"><VisualState.Setters><Setter Target="FileChrome.BorderBrush" Value="{ThemeResource BleeckerTerracottaBrush}"/></VisualState.Setters></VisualState></VisualStateGroup>
     <VisualStateGroup x:Name="FileFocusStates"><VisualState x:Name="FileUnfocused"/><VisualState x:Name="FileFocused"><VisualState.Setters><Setter Target="FileFocusRing.Visibility" Value="Visible"/></VisualState.Setters></VisualState></VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Border x:Name="FileFocusRing" BorderBrush="{ThemeResource BleeckerFileFocusBrush}" BorderThickness="2" Margin="-2" CornerRadius="9" Visibility="Collapsed" IsHitTestVisible="False"/>
    <Border x:Name="FileChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}" UseLayoutRounding="False">
     <Grid x:Name="FileContent" UseLayoutRounding="False"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="FileChooseChrome" Background="{ThemeResource BleeckerFileChooseBackgroundBrush}" CornerRadius="6" UseLayoutRounding="False" Margin="0,0,16,0">
       <TextBlock x:Name="FileChooseText" Foreground="{ThemeResource BleeckerFileChooseForegroundBrush}" FontWeight="Medium" CharacterSpacing="-20" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" UseLayoutRounding="False"/>
      </Border>
      <TextBlock x:Name="FileSelectionText" Grid.Column="1" Foreground="{TemplateBinding Foreground}" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" UseLayoutRounding="False"/>
     </Grid>
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="local:BleeckerFileInput" BasedOn="{StaticResource BleeckerFileInputStyle}"/>
</ResourceDictionary>
