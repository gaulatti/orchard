<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="BleeckerRadarCursorBrush" Color="#CCCCCC" />
   <SolidColorBrush x:Key="BleeckerRadarActiveStrokeBrush" Color="#FFFFFF" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="BleeckerRadarCursorBrush" Color="#CCCCCC" />
   <SolidColorBrush x:Key="BleeckerRadarActiveStrokeBrush" Color="#FFFFFF" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="BleeckerRadarCursorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
   <SolidColorBrush x:Key="BleeckerRadarActiveStrokeBrush" Color="{ThemeResource SystemColorWindowColor}" />
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
