<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="DrawerHandleBrush" Color="#FFE6D5B8" Opacity=".4"/></ResourceDictionary>
  <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="DrawerHandleBrush" Color="#FFE6D5B8" Opacity=".5"/></ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="DrawerHandleBrush" Color="{ThemeResource SystemColorWindowTextColor}"/></ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style x:Key="BleeckerDrawerSurfaceStyle" TargetType="local:BleeckerOverlaySurface" BasedOn="{StaticResource BleeckerAlertDialogSurfaceStyle}"><Setter Property="MaxWidth" Value="Infinity"/><Setter Property="CornerRadius" Value="14,14,0,0"/><Setter Property="BorderThickness" Value="0,1,0,0"/></Style>
 <Style x:Key="BleeckerSheetSurfaceStyle" TargetType="local:BleeckerOverlaySurface" BasedOn="{StaticResource BleeckerAlertDialogSurfaceStyle}"><Setter Property="MaxWidth" Value="384"/><Setter Property="CornerRadius" Value="0"/></Style>
 <Style x:Key="BleeckerSheetLeftSurfaceStyle" TargetType="local:BleeckerOverlaySurface" BasedOn="{StaticResource BleeckerSheetSurfaceStyle}"/>
 <Style x:Key="BleeckerSheetRightSurfaceStyle" TargetType="local:BleeckerOverlaySurface" BasedOn="{StaticResource BleeckerSheetSurfaceStyle}"/>
 <Style x:Key="BleeckerSheetTopSurfaceStyle" TargetType="local:BleeckerOverlaySurface" BasedOn="{StaticResource BleeckerSheetSurfaceStyle}"><Setter Property="MaxWidth" Value="Infinity"/><Setter Property="CornerRadius" Value="0,0,14,14"/></Style>
 <Style x:Key="BleeckerSheetBottomSurfaceStyle" TargetType="local:BleeckerOverlaySurface" BasedOn="{StaticResource BleeckerSheetSurfaceStyle}"><Setter Property="MaxWidth" Value="Infinity"/><Setter Property="CornerRadius" Value="14,14,0,0"/></Style>
 <Style TargetType="local:BleeckerDrawer"><Setter Property="Width" Value="0"/><Setter Property="Height" Value="0"/><Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerDrawer"><Grid x:Name="PART_Layout" UseLayoutRounding="False"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="local:BleeckerSheet"><Setter Property="Width" Value="0"/><Setter Property="Height" Value="0"/><Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerSheet"><Grid x:Name="PART_Layout" UseLayoutRounding="False"/></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
