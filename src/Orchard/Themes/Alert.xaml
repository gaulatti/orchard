<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style TargetType="local:BleeckerAlert">
  <Setter Property="IsTabStop" Value="{Binding IsOpen, RelativeSource={RelativeSource Self}}" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
  <Setter Property="MaxWidth" Value="448" />
  <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Medium" />
  <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" /><Setter Property="Background" Value="{ThemeResource BleeckerAlertBackgroundBrush}" />
  <Setter Property="CornerRadius" Value="{StaticResource BleeckerCardCornerRadius}" /><Setter Property="HighContrastAdjustment" Value="None" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerAlert">
   <Grid>
    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="AlertTypes">
     <VisualState x:Name="AlertInfo" />
     <VisualState x:Name="AlertSuccess"><VisualState.Setters><Setter Target="PART_Surface.BorderBrush" Value="{ThemeResource BleeckerAlertSuccessBorderBrush}" /><Setter Target="InfoIcon.Visibility" Value="Collapsed" /><Setter Target="SuccessIcon.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
     <VisualState x:Name="AlertError"><VisualState.Setters><Setter Target="PART_Surface.BorderBrush" Value="{ThemeResource BleeckerAlertErrorBorderBrush}" /><Setter Target="InfoIcon.Visibility" Value="Collapsed" /><Setter Target="ErrorIcon.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
     <VisualState x:Name="AlertWarning"><VisualState.Setters><Setter Target="PART_Surface.BorderBrush" Value="{ThemeResource BleeckerAlertWarningBorderBrush}" /><Setter Target="InfoIcon.Visibility" Value="Collapsed" /><Setter Target="WarningIcon.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
    </VisualStateGroup></VisualStateManager.VisualStateGroups>
    <Popup x:Name="PART_Popup" ShouldConstrainToRootBounds="True" IsLightDismissEnabled="False">
     <Grid x:Name="PART_MotionRoot" FlowDirection="{TemplateBinding FlowDirection}"><Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
      <local:BleeckerOverlaySurface x:Name="PART_Surface" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderBrush="{ThemeResource BleeckerAlertInfoBorderBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Padding="16">
       <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Viewbox Width="20" Height="20" Margin="0,2,0,0" VerticalAlignment="Top" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
         <Canvas Width="24" Height="24">
          <!-- Lucide 0.563.0; see licenses/LICENSE-Lucide.txt. -->
          <Path x:Name="InfoIcon" Data="M12 2a10 10 0 1 0 0 20a10 10 0 0 0 0-20 M12 16v-4 M12 8h.01" Stroke="{ThemeResource BleeckerAlertInfoIconBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          <Path x:Name="SuccessIcon" Visibility="Collapsed" Data="M12 2a10 10 0 1 0 0 20a10 10 0 0 0 0-20 M9 12l2 2l4-4" Stroke="{ThemeResource BleeckerAlertSuccessIconBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          <Path x:Name="ErrorIcon" Visibility="Collapsed" Data="M12 2a10 10 0 1 0 0 20a10 10 0 0 0 0-20 M12 8v4 M12 16h.01" Stroke="{ThemeResource BleeckerAlertErrorIconBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          <Path x:Name="WarningIcon" Visibility="Collapsed" Data="M21.73 18l-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3 M12 9v4 M12 17h.01" Stroke="{ThemeResource BleeckerAlertWarningIconBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
         </Canvas>
        </Viewbox>
        <TextBlock x:Name="PART_Message" Grid.Column="1" Text="{TemplateBinding Message}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" LineHeight="24" LineStackingStrategy="BlockLineHeight" AutomationProperties.LiveSetting="Polite" />
        <Button x:Name="PART_Close" Grid.Column="2" Width="24" Height="24" Margin="0,-2,-4,0" Padding="4" MinWidth="0" MinHeight="0" VerticalAlignment="Top" IsEnabled="{TemplateBinding IsEnabled}" Foreground="{TemplateBinding Foreground}" AutomationProperties.Name="Close alert" UseSystemFocusVisuals="True" FocusVisualPrimaryBrush="{ThemeResource BleeckerButtonFocusRingBrush}" FocusVisualSecondaryBrush="{ThemeResource BleeckerFocusOffsetBrush}">
         <Button.Template><ControlTemplate TargetType="Button">
          <Grid RenderTransformOrigin=".5,.5"><Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
           <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal" /><VisualState x:Name="Disabled" />
            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="PART_ClosePalette.Background" Value="{ThemeResource BleeckerAlertCloseHoverBrush}" /><Setter Target="PART_CloseIcon.Stroke" Value="{ThemeResource BleeckerAlertCloseHoverTextBrush}" /></VisualState.Setters></VisualState>
            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="PART_ClosePalette.Background" Value="{ThemeResource BleeckerAlertCloseHoverBrush}" /><Setter Target="PART_CloseIcon.Stroke" Value="{ThemeResource BleeckerAlertCloseHoverTextBrush}" /></VisualState.Setters></VisualState>
           </VisualStateGroup></VisualStateManager.VisualStateGroups>
           <Border x:Name="PART_ClosePalette" Background="Transparent" Visibility="Collapsed" />
           <Border x:Name="PART_CloseChrome" Background="Transparent" CornerRadius="6" />
           <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path x:Name="PART_CloseIcon" Data="M18 6L6 18 M6 6l12 12" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
          </Grid>
         </ControlTemplate></Button.Template>
        </Button>
       </Grid>
      </local:BleeckerOverlaySurface>
     </Grid>
    </Popup>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
