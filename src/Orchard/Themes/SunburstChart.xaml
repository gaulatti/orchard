<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style TargetType="local:BleeckerSunburstChart">
  <Setter Property="Height" Value="350" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
  <Setter Property="UseLayoutRounding" Value="False" /><Setter Property="IsTabStop" Value="False" /><Setter Property="HighContrastAdjustment" Value="None" />
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Bold" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerSunburstChart"><Canvas x:Name="PART_Plot" Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
