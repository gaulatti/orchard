<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="RadioOff" Color="#E6D5B8" Opacity=".4"/><SolidColorBrush x:Key="RadioHover" Color="#2C5784" Opacity=".6"/><SolidColorBrush x:Key="RadioOn" Color="#2C5784"/></ResourceDictionary>
  <ResourceDictionary x:Key="Default"><SolidColorBrush x:Key="RadioOff" Color="#1A2332" Opacity=".6"/><SolidColorBrush x:Key="RadioHover" Color="#5BA3F5" Opacity=".6"/><SolidColorBrush x:Key="RadioOn" Color="#5BA3F5"/></ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="RadioOff" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="RadioHover" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="RadioOn" Color="{ThemeResource SystemColorHighlightColor}"/></ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style x:Key="BleeckerRadioOptionStyle" TargetType="Button">
  <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource RadioOn}"/><Setter Property="FocusVisualPrimaryThickness" Value="2"/><Setter Property="FocusVisualSecondaryThickness" Value="0"/><Setter Property="FocusVisualMargin" Value="-3"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid UseLayoutRounding="False" x:Name="OptionRoot" Background="Transparent" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid UseLayoutRounding="False" Width="18" Height="18" Margin="0,2,0,0" VerticalAlignment="Top"><Ellipse x:Name="RadioRing" StrokeThickness="2" Width="18" Height="18" Stroke="{ThemeResource RadioOff}"/><Ellipse x:Name="RadioDot" Width="8" Height="8" Fill="{ThemeResource RadioOn}" RenderTransformOrigin=".5,.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0"/></Ellipse.RenderTransform></Ellipse></Grid>
    <StackPanel UseLayoutRounding="False" Grid.Column="1"><TextBlock UseLayoutRounding="False" TextReadingOrder="UseFlowDirection" x:Name="RadioLabel" FontFamily="{StaticResource BleeckerPrimaryMediumFontFamily}" FontSize="14" FontWeight="Medium" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="{ThemeResource BleeckerTextPrimaryBrush}" AutomationProperties.AccessibilityView="Raw"/><TextBlock UseLayoutRounding="False" TextReadingOrder="UseFlowDirection" x:Name="RadioDescription" FontFamily="{StaticResource BleeckerPrimaryFontFamily}" FontSize="12" LineHeight="19.5" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/></StackPanel>
    <Canvas Visibility="Collapsed"><TextBlock x:Name="OffProbe" Foreground="{ThemeResource RadioOff}"/><TextBlock x:Name="HoverProbe" Foreground="{ThemeResource RadioHover}"/><TextBlock x:Name="OnProbe" Foreground="{ThemeResource RadioOn}"/></Canvas>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="local:BleeckerRadioGroup"><Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerRadioGroup"><Grid UseLayoutRounding="False" x:Name="PART_Root"/></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
