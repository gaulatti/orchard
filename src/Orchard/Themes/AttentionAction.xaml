<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="BleeckerAttentionActionStyle" TargetType="Button">
  <Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
  <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
  <Setter Property="UseSystemFocusVisuals" Value="False" /><Setter Property="HighContrastAdjustment" Value="None" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
