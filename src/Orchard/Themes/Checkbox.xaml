<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CheckboxOffFill" Color="White" />
            <SolidColorBrush x:Key="CheckboxOnFill" Color="#2C5784" />
            <SolidColorBrush x:Key="CheckboxOffStroke" Color="#E6D5B8" Opacity="0.60" />
            <SolidColorBrush x:Key="CheckboxHoverStroke" Color="#2C5784" Opacity="0.50" />
            <SolidColorBrush x:Key="CheckboxOnStroke" Color="#2C5784" />
            <SolidColorBrush x:Key="CheckboxFocusStroke" Color="#2C5784" Opacity="0.20" />
            <SolidColorBrush x:Key="CheckboxGlyph" Color="White" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="CheckboxOffFill" Color="#1A374D" />
            <SolidColorBrush x:Key="CheckboxOnFill" Color="#5BA3F5" />
            <SolidColorBrush x:Key="CheckboxOffStroke" Color="White" Opacity="0.20" />
            <SolidColorBrush x:Key="CheckboxHoverStroke" Color="#2C5784" Opacity="0.50" />
            <SolidColorBrush x:Key="CheckboxOnStroke" Color="#5BA3F5" />
            <SolidColorBrush x:Key="CheckboxFocusStroke" Color="#2C5784" Opacity="0.20" />
            <SolidColorBrush x:Key="CheckboxGlyph" Color="White" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CheckboxOffFill" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CheckboxOnFill" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CheckboxOffStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CheckboxHoverStroke" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CheckboxOnStroke" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CheckboxFocusStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CheckboxGlyph" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
