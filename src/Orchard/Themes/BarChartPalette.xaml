<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="BleeckerBarCursorBrush" Color="#FFF9F6F2" /></ResourceDictionary>
  <ResourceDictionary x:Key="Default"><SolidColorBrush x:Key="BleeckerBarCursorBrush" Color="#FF1A2332" /></ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="BleeckerBarCursorBrush" Color="{ThemeResource SystemColorHighlightColor}" /></ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
