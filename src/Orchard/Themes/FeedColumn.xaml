<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <SolidColorBrush x:Key="FeedColumnHeaderBorder" Color="White" Opacity="0.065"/>
 <SolidColorBrush x:Key="FeedColumnCountBorder" Color="White" Opacity="0.08"/>
 <SolidColorBrush x:Key="FeedColumnCountBackground" Color="Black" Opacity="0.15"/>
 <Style TargetType="local:BleeckerFeedColumn">
  <Setter Property="RequestedTheme" Value="Dark"/>
  <Setter Property="Width" Value="372"/><Setter Property="MinWidth" Value="372"/>
  <Setter Property="Accent" Value="{ThemeResource BleeckerSeaBrush}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="12"/>
  <Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="FontSize" Value="16"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerFeedColumn">
   <Grid x:Name="PART_Root" UseLayoutRounding="False" FlowDirection="LeftToRight">
    <Grid x:Name="PART_ShadowHost" IsHitTestVisible="False" UseLayoutRounding="False"/>
    <Border x:Name="PART_Surface" UseLayoutRounding="False" BackgroundSizing="OuterBorderEdge"/>
    <Path x:Name="PART_ShadowMask" Visibility="Collapsed" Fill="White"/><Path x:Name="PART_ShadowExterior" Visibility="Collapsed" Fill="White"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
