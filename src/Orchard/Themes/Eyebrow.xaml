<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EyebrowAccent" Color="#8A5735" />
            <SolidColorBrush x:Key="EyebrowMuted" Color="#595959" />
            <SolidColorBrush x:Key="EyebrowInverse" Color="White" Opacity="0.75" />
            <SolidColorBrush x:Key="EyebrowForeground" Color="#8A5735" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="EyebrowAccent" Color="#E0AC69" />
            <SolidColorBrush x:Key="EyebrowMuted" Color="#B8C5D6" />
            <SolidColorBrush x:Key="EyebrowInverse" Color="White" Opacity="0.75" />
            <SolidColorBrush x:Key="EyebrowForeground" Color="#E0AC69" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EyebrowForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
