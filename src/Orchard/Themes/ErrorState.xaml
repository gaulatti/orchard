<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style TargetType="local:BleeckerErrorState">
  <Setter Property="IsTabStop" Value="False" /><Setter Property="UseSystemFocusVisuals" Value="False" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
  <Setter Property="HighContrastAdjustment" Value="None" /><Setter Property="UseLayoutRounding" Value="False" />
  <Setter Property="Padding" Value="32,56" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource BleeckerCardCornerRadius}" />
  <Setter Property="Background" Value="{ThemeResource BleeckerTerracottaBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource BleeckerTerracottaBrush}" />
  <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerErrorState">
   <Grid x:Name="PART_Surface">
    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="Appearance">
     <VisualState x:Name="ErrorLight"><VisualState.Setters><Setter Target="PART_Background.Opacity" Value="0.035" /><Setter Target="PART_IconBackground.Opacity" Value="0.07" /></VisualState.Setters></VisualState>
     <VisualState x:Name="ErrorDark"><VisualState.Setters><Setter Target="PART_Background.Opacity" Value="0.07" /><Setter Target="PART_IconBackground.Opacity" Value="0.15" /></VisualState.Setters></VisualState>
     <VisualState x:Name="ErrorContrast"><VisualState.Setters>
      <Setter Target="PART_Background.Background" Value="{ThemeResource BleeckerBackgroundBrush}" /><Setter Target="PART_Background.Opacity" Value="1" />
      <Setter Target="PART_Border.Opacity" Value="1" /><Setter Target="PART_IconBorder.Opacity" Value="1" />
      <Setter Target="PART_IconBackground.Background" Value="{ThemeResource BleeckerBackgroundBrush}" /><Setter Target="PART_IconBackground.Opacity" Value="1" />
     </VisualState.Setters></VisualState>
    </VisualStateGroup><VisualStateGroup x:Name="TitleContent">
     <VisualState x:Name="TitlePresent" /><VisualState x:Name="TitleEmpty"><VisualState.Setters><Setter Target="PART_Title.Height" Value="0" /></VisualState.Setters></VisualState>
    </VisualStateGroup></VisualStateManager.VisualStateGroups>
    <Border x:Name="PART_Background" Background="{TemplateBinding Background}" Opacity="0.035" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
    <Border x:Name="PART_Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Opacity="0.25" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
    <Border BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <StackPanel Spacing="20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <Grid x:Name="PART_IconBox" Width="48" Height="48" HorizontalAlignment="Center">
       <Border x:Name="PART_IconBackground" Background="{ThemeResource BleeckerTerracottaBrush}" Opacity="0.07" CornerRadius="10" IsHitTestVisible="False" />
       <Border x:Name="PART_IconBorder" BorderBrush="{ThemeResource BleeckerTerracottaBrush}" BorderThickness="1" Opacity="0.15" CornerRadius="10" IsHitTestVisible="False" />
       <!-- Lucide 0.563.0 circle-alert and refresh-cw; package Lucide notice applies. -->
       <Viewbox x:Name="PART_DefaultIcon" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
        <Canvas Width="24" Height="24"><Ellipse Width="20" Height="20" Canvas.Left="2" Canvas.Top="2" Stroke="{ThemeResource BleeckerTerracottaBrush}" StrokeThickness="2" />
         <Path Data="M12 8v4 M12 16h.01" Stroke="{ThemeResource BleeckerTerracottaBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Canvas>
       </Viewbox>
       <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Foreground="{ThemeResource BleeckerTerracottaBrush}" />
      </Grid>
      <StackPanel x:Name="PART_Text" Spacing="4">
       <TextBlock x:Name="PART_Title" Text="{TemplateBinding Title}" Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource BleeckerPrimarySemiboldFontFamily}" FontWeight="SemiBold" FontSize="16" CharacterSpacing="-20" LineHeight="24" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" HighContrastAdjustment="None" />
       <TextBlock x:Name="PART_Description" Text="{TemplateBinding Description}" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" MaxWidth="320" HorizontalAlignment="Center" FontFamily="{StaticResource BleeckerPrimaryFontFamily}" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextAlignment="Center" TextWrapping="Wrap" HighContrastAdjustment="None" />
      </StackPanel>
      <local:BleeckerButton x:Name="PART_Retry" Variant="Secondary" Size="Small" HorizontalAlignment="Center" Command="{TemplateBinding RetryCommand}" CommandParameter="{TemplateBinding RetryCommandParameter}" Visibility="Collapsed">
       <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"><Canvas Width="24" Height="24">
         <Path x:Name="PART_RetryIcon" Data="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Canvas></Viewbox>
        <TextBlock x:Name="PART_RetryLabel" Text="{TemplateBinding RetryLabel}" VerticalAlignment="Center" FontFamily="{StaticResource BleeckerPrimaryMediumFontFamily}" FontSize="13" HighContrastAdjustment="None" />
       </StackPanel>
      </local:BleeckerButton>
     </StackPanel>
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
