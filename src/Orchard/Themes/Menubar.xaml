<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="MenubarBarBorderBrush" Color="#FFE6D5B8" Opacity=".3"/></ResourceDictionary>
  <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="MenubarBarBorderBrush" Color="White" Opacity=".1"/></ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="MenubarBarBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/></ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style x:Key="BleeckerMenubarTriggerStyle" TargetType="Button">
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="Foreground" Value="{ThemeResource BleeckerTextSecondaryBrush}"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Padding" Value="12,6"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="CornerRadius" Value="{StaticResource BleeckerUiCornerRadius}"/><Setter Property="UseSystemFocusVisuals" Value="False"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
   <VisualStateManager.VisualStateGroups>
    <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value=".5"/></VisualState.Setters></VisualState></VisualStateGroup>
    <VisualStateGroup x:Name="MenuStates"><VisualState x:Name="MenuClosed"/><VisualState x:Name="MenuHover"><VisualState.Setters><Setter Target="MenuPalette.Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/><Setter Target="MenuPalette.Background" Value="{ThemeResource BleeckerMenuHoverBrush}"/></VisualState.Setters></VisualState><VisualState x:Name="MenuOpen"><VisualState.Setters><Setter Target="MenuPalette.Background" Value="{ThemeResource BleeckerAccentBlueBrush}"/><Setter Target="MenuPalette.Foreground" Value="White"/></VisualState.Setters></VisualState></VisualStateGroup>
    <VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused"/><VisualState x:Name="PointerFocused"/><VisualState x:Name="Focused"><VisualState.Setters><Setter Target="Focus.Opacity" Value="1"/></VisualState.Setters></VisualState></VisualStateGroup>
   </VisualStateManager.VisualStateGroups>
   <ContentPresenter x:Name="MenuPalette" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
   <Border x:Name="MenuPaint" CornerRadius="{TemplateBinding CornerRadius}"/>
   <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center"/>
   <Border x:Name="Focus" BorderBrush="{ThemeResource BleeckerAccentBlueBrush}" BorderThickness="2" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False"/>
  </Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BleeckerMenubarItemStyle" TargetType="Button" BasedOn="{StaticResource BleeckerMenubarTriggerStyle}">
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/>
 </Style>
 <Style x:Key="BleeckerMenubarSurfaceStyle" TargetType="local:BleeckerOverlaySurface">
  <Setter Property="Width" Value="224"/><Setter Property="MinWidth" Value="224"/><Setter Property="Padding" Value="6"/><Setter Property="BorderThickness" Value="1"/>
 </Style>
 <Style x:Key="BleeckerMenubarSubmenuSurfaceStyle" TargetType="local:BleeckerOverlaySurface" BasedOn="{StaticResource BleeckerMenubarSurfaceStyle}">
  <Setter Property="Width" Value="192"/><Setter Property="MinWidth" Value="192"/>
 </Style>
 <Style TargetType="local:BleeckerMenubar">
  <Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Top"/>
  <Setter Property="Background" Value="{ThemeResource BleeckerMenuBackgroundBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource MenubarBarBorderBrush}"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/><Setter Property="CornerRadius" Value="{StaticResource BleeckerUiCornerRadius}"/>
  <Setter Property="TriggerStyle" Value="{StaticResource BleeckerMenubarTriggerStyle}"/><Setter Property="ItemStyle" Value="{StaticResource BleeckerMenubarItemStyle}"/>
  <Setter Property="SurfaceStyle" Value="{StaticResource BleeckerMenubarSurfaceStyle}"/><Setter Property="SubmenuSurfaceStyle" Value="{StaticResource BleeckerMenubarSubmenuSurfaceStyle}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerMenubar">
   <local:BleeckerCard Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
    <Grid x:Name="PART_Layout" UseLayoutRounding="False"><StackPanel x:Name="PART_Triggers" Orientation="Horizontal" Spacing="2" TabFocusNavigation="Once" UseLayoutRounding="False" HorizontalAlignment="Left"/></Grid>
   </local:BleeckerCard>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
