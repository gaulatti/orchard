<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="AccordionSurface" Color="White"/><SolidColorBrush x:Key="AccordionBorder" Color="#E6D5B8" Opacity=".3"/><SolidColorBrush x:Key="AccordionDivider" Color="#E6D5B8" Opacity=".2"/><SolidColorBrush x:Key="AccordionBodyBorder" Color="#E6D5B8" Opacity=".15"/><SolidColorBrush x:Key="AccordionBody" Color="#F9F6F2" Opacity=".25"/><SolidColorBrush x:Key="AccordionHover" Color="#F9F6F2" Opacity=".35"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="AccordionSurface" Color="#182533"/><SolidColorBrush x:Key="AccordionBorder" Color="White" Opacity=".1"/><SolidColorBrush x:Key="AccordionDivider" Color="White" Opacity=".07"/><SolidColorBrush x:Key="AccordionBodyBorder" Color="White" Opacity=".05"/><SolidColorBrush x:Key="AccordionBody" Color="White" Opacity=".02"/><SolidColorBrush x:Key="AccordionHover" Color="White" Opacity=".03"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="AccordionSurface" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="AccordionBorder" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="AccordionDivider" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="AccordionBodyBorder" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="AccordionBody" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="AccordionHover" Color="{ThemeResource SystemColorHighlightColor}"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style x:Key="BleeckerAccordionHeaderStyle" TargetType="Button">
  <Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
  <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BleeckerSeaBrush}"/><Setter Property="FocusVisualPrimaryThickness" Value="2"/><Setter Property="FocusVisualSecondaryThickness" Value="0"/><Setter Property="FocusVisualMargin" Value="0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" UseLayoutRounding="False"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="local:BleeckerAccordion">
  <Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="HighContrastAdjustment" Value="None"/><Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/><Setter Property="Background" Value="{ThemeResource AccordionSurface}"/><Setter Property="BorderBrush" Value="{ThemeResource AccordionBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerAccordion">
   <Grid UseLayoutRounding="False">
    <Grid x:Name="PART_ShadowNear" IsHitTestVisible="False"/><Grid x:Name="PART_ShadowFar" IsHitTestVisible="False"/>
    <Canvas Opacity="0" IsHitTestVisible="False"><Path x:Name="PART_MaskNear" Fill="White"/><Path x:Name="PART_ExteriorNear" Fill="White"/><Path x:Name="PART_MaskFar" Fill="White"/><Path x:Name="PART_ExteriorFar" Fill="White"/></Canvas>
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" UseLayoutRounding="False"><StackPanel x:Name="PART_Rows" UseLayoutRounding="False"/></Border>
    <Canvas Visibility="Collapsed"><TextBlock x:Name="PART_Primary" Foreground="{TemplateBinding Foreground}"/><TextBlock x:Name="PART_Secondary" Foreground="{ThemeResource BleeckerTextSecondaryBrush}"/><TextBlock x:Name="PART_Divider" Foreground="{ThemeResource AccordionDivider}"/><TextBlock x:Name="PART_BodyBorder" Foreground="{ThemeResource AccordionBodyBorder}"/><TextBlock x:Name="PART_Body" Foreground="{ThemeResource AccordionBody}"/><TextBlock x:Name="PART_Hover" Foreground="{ThemeResource AccordionHover}"/></Canvas>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
