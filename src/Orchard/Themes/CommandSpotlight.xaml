<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style x:Key="BleeckerCommandSpotlightActionStyle" TargetType="Button">
  <Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="7"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" UseLayoutRounding="False"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BleeckerCommandSpotlightTriggerStyle" TargetType="Button" BasedOn="{StaticResource BleeckerCommandSpotlightActionStyle}">
  <Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Padding" Value="12,6"/>
 </Style>
 <Style x:Key="BleeckerCommandSpotlightSurfaceStyle" TargetType="local:BleeckerOverlaySurface">
  <Setter Property="Background" Value="{ThemeResource BleeckerSpotlightSurfaceBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource BleeckerSpotlightBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="MaxWidth" Value="672"/><Setter Property="Padding" Value="0"/><Setter Property="UseLayoutRounding" Value="False"/>
 </Style>
 <Style x:Key="BleeckerCommandSpotlightEditorStyle" TargetType="TextBox">
  <Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/><Setter Property="FontSize" Value="16"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid Background="{TemplateBinding Background}"><ScrollViewer x:Name="ContentElement" IsTabStop="False" Padding="0" FlowDirection="{TemplateBinding FlowDirection}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" CharacterSpacing="{TemplateBinding CharacterSpacing}" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden" ZoomMode="Disabled" UseLayoutRounding="False"/></Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="local:BleeckerCommandSpotlight">
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/><Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerCommandSpotlight"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}" UseLayoutRounding="False"><Grid UseLayoutRounding="False">
   <TextBlock x:Name="PART_Primary" Foreground="{ThemeResource BleeckerTextPrimaryBrush}" Visibility="Collapsed"/><TextBlock x:Name="PART_Secondary" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_Surface" Foreground="{ThemeResource BleeckerSpotlightSurfaceBrush}" Visibility="Collapsed"/><TextBlock x:Name="PART_Border" Foreground="{ThemeResource BleeckerSpotlightBorderBrush}" Visibility="Collapsed"/><TextBlock x:Name="PART_HeaderBorder" Foreground="{ThemeResource BleeckerSpotlightHeaderBorderBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_SelectedBackground" Foreground="{ThemeResource BleeckerSpotlightSelectedBackgroundBrush}" Visibility="Collapsed"/><TextBlock x:Name="PART_SelectedForeground" Foreground="{ThemeResource BleeckerSpotlightSelectedForegroundBrush}" Visibility="Collapsed"/><TextBlock x:Name="PART_RowHover" Foreground="{ThemeResource BleeckerSpotlightRowHoverBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_IconBackground" Foreground="{ThemeResource BleeckerSpotlightIconBackgroundBrush}" Visibility="Collapsed"/><TextBlock x:Name="PART_IconBorder" Foreground="{ThemeResource BleeckerSpotlightIconBorderBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_TriggerBackground" Foreground="{ThemeResource BleeckerSpotlightTriggerBackgroundBrush}" Visibility="Collapsed"/><TextBlock x:Name="PART_TriggerBorder" Foreground="{ThemeResource BleeckerSpotlightTriggerBorderBrush}" Visibility="Collapsed"/><TextBlock x:Name="PART_TriggerHover" Foreground="{ThemeResource BleeckerSpotlightTriggerHoverBrush}" Visibility="Collapsed"/><TextBlock x:Name="PART_TriggerHoverBorder" Foreground="{ThemeResource BleeckerSpotlightTriggerHoverBorderBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_Focus" Foreground="{ThemeResource BleeckerSpotlightFocusBrush}" Visibility="Collapsed"/><TextBlock x:Name="PART_Backdrop" Foreground="{ThemeResource BleeckerSpotlightBackdropBrush}" Visibility="Collapsed"/>
   <Grid x:Name="PART_Root" UseLayoutRounding="False"/>
  </Grid></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
