<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/Tokens.g.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="BleeckerHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimarySemiboldFontFamily}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BleeckerBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BleeckerSecondaryFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BleeckerSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerButtonCornerRadius}" />
        <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style x:Key="BleeckerPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentButtonBorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerButtonCornerRadius}" />
        <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style x:Key="BleeckerTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource BleeckerSecondaryFontFamily}" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerUiCornerRadius}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="{ThemeResource BleeckerCardBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BleeckerBorderBrush}" />
    </Style>
    <Style x:Key="BleeckerComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerUiCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource BleeckerCardBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BleeckerBorderBrush}" />
    </Style>
</ResourceDictionary>
