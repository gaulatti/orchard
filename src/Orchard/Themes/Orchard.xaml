<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/Tokens.g.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/SparklinePalette.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/BarChartPalette.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/AreaChartPalette.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/PieChartPalette.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/ScatterChartPalette.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/StatCardPalette.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/Menus.g.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/Breadcrumb.xaml" />
        <ResourceDictionary Source="ms-appx:///Orchard/Themes/AttentionAction.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="BleeckerHeadingStyle" TargetType="TextBlock">
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimarySemiboldFontFamily}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BleeckerBodyStyle" TargetType="TextBlock">
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerSecondaryFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BleeckerSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerButtonCornerRadius}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BleeckerButtonFocusRingBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource BleeckerFocusOffsetBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="FocusVisualMargin" Value="-4" />
    </Style>
    <Style x:Key="BleeckerPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="Background" Value="{ThemeResource AccentButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentButtonBorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerButtonCornerRadius}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BleeckerButtonFocusRingBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource BleeckerFocusOffsetBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="FocusVisualMargin" Value="-4" />
    </Style>
    <Style x:Key="BleeckerToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource ToggleButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource ToggleButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerButtonCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BleeckerToggleFocusRingBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource BleeckerFocusOffsetBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="-2" />
    </Style>
    <Style x:Key="BleeckerSmallToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource BleeckerToggleStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style x:Key="BleeckerLargeToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource BleeckerToggleStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="16,6" />
    </Style>
    <Style x:Key="BleeckerOutlineToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource BleeckerToggleStyle}">
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="BleeckerSmallOutlineToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource BleeckerSmallToggleStyle}">
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="BleeckerLargeOutlineToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource BleeckerLargeToggleStyle}">
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="BleeckerTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource BleeckerSecondaryFontFamily}" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerUiCornerRadius}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="{ThemeResource BleeckerCardBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BleeckerBorderBrush}" />
    </Style>
    <Style x:Key="BleeckerComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" />
        <Setter Property="CornerRadius" Value="{StaticResource BleeckerUiCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource BleeckerCardBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BleeckerBorderBrush}" />
    </Style>
</ResourceDictionary>
