<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="FilterBorder" Color="#E6D5B8" Opacity=".35" /><SolidColorBrush x:Key="FilterRemoveHoverBackground" Color="#E6D5B8" Opacity=".2" />
   <SolidColorBrush x:Key="FilterClearHover" Color="#1A374D" /><SolidColorBrush x:Key="FilterTransparent" Color="Transparent" />
   <SolidColorBrush x:Key="FilterRemoveHoverForeground" Color="#A65D57" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="FilterBorder" Color="White" Opacity=".12" /><SolidColorBrush x:Key="FilterRemoveHoverBackground" Color="White" Opacity=".07" />
   <SolidColorBrush x:Key="FilterClearHover" Color="#F0F4F8" /><SolidColorBrush x:Key="FilterTransparent" Color="Transparent" />
   <SolidColorBrush x:Key="FilterRemoveHoverForeground" Color="#D47B75" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="FilterBorder" Color="{ThemeResource SystemColorWindowTextColor}" /><SolidColorBrush x:Key="FilterRemoveHoverBackground" Color="{ThemeResource SystemColorHighlightColor}" />
   <SolidColorBrush x:Key="FilterClearHover" Color="{ThemeResource SystemColorHighlightColor}" /><SolidColorBrush x:Key="FilterTransparent" Color="Transparent" />
   <SolidColorBrush x:Key="FilterRemoveHoverForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style TargetType="local:BleeckerFilterChip">
  <Setter Property="IsTabStop" Value="False" /><Setter Property="UseLayoutRounding" Value="False" /><Setter Property="HighContrastAdjustment" Value="None" />
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="FontSize" Value="12" />
  <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" /><Setter Property="Background" Value="{ThemeResource BleeckerCardBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource FilterBorder}" />
  <Setter Property="Padding" Value="10,4" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="28" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerFilterChip">
   <Grid>
    <Grid Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="PART_Secondary" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" /><TextBlock x:Name="PART_RemoveHover" Foreground="{ThemeResource FilterRemoveHoverForeground}" /><TextBlock x:Name="PART_RemoveHoverBackground" Foreground="{ThemeResource FilterRemoveHoverBackground}" /></Grid>
    <Border x:Name="PART_Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><Grid x:Name="PART_Content" /></Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="local:BleeckerFilterGroup">
  <Setter Property="IsTabStop" Value="False" /><Setter Property="UseLayoutRounding" Value="False" /><Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="FontSize" Value="12" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerFilterGroup"><Grid>
   <Grid Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="PART_Clear" Foreground="{ThemeResource BleeckerPrimaryBrush}" /><TextBlock x:Name="PART_ClearHover" Foreground="{ThemeResource FilterClearHover}" /><TextBlock x:Name="PART_Transparent" Foreground="{ThemeResource FilterTransparent}" /></Grid>
   <Grid x:Name="PART_Content" />
  </Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
