<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style x:Key="BleeckerHeroCarouselLinkStyle" TargetType="HyperlinkButton">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,64,0,32"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BleeckerAccentBlueBrush}"/><Setter Property="FocusVisualPrimaryThickness" Value="2"/><Setter Property="FocusVisualSecondaryThickness" Value="0"/><Setter Property="FocusVisualMargin" Value="-4"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="HyperlinkButton"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" UseLayoutRounding="False"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"/></VisualStateGroup></VisualStateManager.VisualStateGroups></ContentPresenter></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BleeckerHeroCarouselArrowStyle" TargetType="Button">
  <Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="CornerRadius" Value="7"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Background" Value="{ThemeResource BleeckerHeroArrowBackgroundBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource BleeckerHeroArrowBorderBrush}"/><Setter Property="Foreground" Value="{ThemeResource BleeckerHeroArrowForegroundBrush}"/>
  <Setter Property="UseLayoutRounding" Value="False"/><Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BleeckerAccentBlueBrush}"/><Setter Property="FocusVisualPrimaryThickness" Value="2"/><Setter Property="FocusVisualSecondaryThickness" Value="0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="ArrowSurface" RenderTransformOrigin=".5,.5" UseLayoutRounding="False">
   <Grid.RenderTransform><CompositeTransform x:Name="ArrowTransform"/></Grid.RenderTransform>
   <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ArrowChrome.Background" Value="{ThemeResource BleeckerHeroArrowHoverBrush}"/><Setter Target="ArrowChrome.BorderBrush" Value="{ThemeResource BleeckerHeroArrowBorderHoverBrush}"/><Setter Target="ArrowContent.Foreground" Value="{ThemeResource BleeckerHeroArrowForegroundHoverBrush}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ArrowChrome.Background" Value="{ThemeResource BleeckerHeroArrowHoverBrush}"/><Setter Target="ArrowChrome.BorderBrush" Value="{ThemeResource BleeckerHeroArrowBorderHoverBrush}"/><Setter Target="ArrowContent.Foreground" Value="{ThemeResource BleeckerHeroArrowForegroundHoverBrush}"/><Setter Target="ArrowTransform.ScaleX" Value=".97"/><Setter Target="ArrowTransform.ScaleY" Value=".97"/><Setter Target="ArrowTransform.TranslateY" Value="1"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ArrowSurface.Opacity" Value=".45"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
   <Border x:Name="HeroArrowBackdrop" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" UseLayoutRounding="False" AutomationProperties.AccessibilityView="Raw"/>
   <Border x:Name="ArrowChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" UseLayoutRounding="False">
   <ContentPresenter x:Name="ArrowContent" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="{TemplateBinding Padding}" UseLayoutRounding="False"/>
  </Border></Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BleeckerHeroCarouselIndicatorStyle" TargetType="Button">
  <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BleeckerAccentBlueBrush}"/><Setter Property="FocusVisualPrimaryThickness" Value="2"/><Setter Property="FocusVisualSecondaryThickness" Value="0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="IndicatorChrome" Background="{TemplateBinding Background}" UseLayoutRounding="False"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="IndicatorChrome.Opacity" Value=".45"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" UseLayoutRounding="False"/></Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BleeckerHeroCarouselTagStyle" TargetType="Border"><Setter Property="Padding" Value="10,4"/><Setter Property="CornerRadius" Value="6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{ThemeResource BleeckerHeroTagBackgroundBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource BleeckerHeroTagBorderBrush}"/><Setter Property="UseLayoutRounding" Value="False"/></Style>
 <Style x:Key="BleeckerHeroCarouselCtaStyle" TargetType="Border"><Setter Property="Padding" Value="20,10"/><Setter Property="CornerRadius" Value="7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{ThemeResource BleeckerHeroCtaBackgroundBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource BleeckerHeroCtaBorderBrush}"/><Setter Property="UseLayoutRounding" Value="False"/></Style>
 <Style TargetType="local:BleeckerHeroCarousel"><Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{ThemeResource BleeckerHeroForegroundBrush}"/><Setter Property="Padding" Value="0"/><Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="LinkStyle" Value="{StaticResource BleeckerHeroCarouselLinkStyle}"/><Setter Property="ArrowStyle" Value="{StaticResource BleeckerHeroCarouselArrowStyle}"/><Setter Property="IndicatorStyle" Value="{StaticResource BleeckerHeroCarouselIndicatorStyle}"/><Setter Property="TagStyle" Value="{StaticResource BleeckerHeroCarouselTagStyle}"/><Setter Property="CtaStyle" Value="{StaticResource BleeckerHeroCarouselCtaStyle}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerHeroCarousel"><Border x:Name="PART_Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Disabled"/></VisualStateGroup></VisualStateManager.VisualStateGroups><Grid x:Name="PART_Root" UseLayoutRounding="False"/></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
