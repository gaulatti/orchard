 <Style x:Key="BleeckerCalendarWeekdayStyle" TargetType="TextBlock" BasedOn="{StaticResource BleeckerDateSecondaryTextStyle}"><Setter Property="FontFamily" Value="{StaticResource BleeckerPrimarySemiboldFontFamily}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="10"/><Setter Property="LineHeight" Value="15"/><Setter Property="CharacterSpacing" Value="80"/></Style>
