 <Style x:Key="BleeckerCalendarDayStyle" TargetType="ToggleButton">
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="HighContrastAdjustment" Value="None"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BleeckerDateDayFocusBrush}"/><Setter Property="FocusVisualSecondaryThickness" Value="0"/><Setter Property="FocusVisualPrimaryThickness" Value="2"/><Setter Property="FocusVisualMargin" Value="-2"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Grid x:Name="DayRoot" Background="Transparent">
    <VisualStateManager.VisualStateGroups>
     <VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/><VisualState x:Name="Checked"/><VisualState x:Name="Indeterminate"/>
      <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
      <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Pressed"/>
      <VisualState x:Name="CheckedPressed"/>
      <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="DayRoot.Opacity" Value=".3"/></VisualState.Setters></VisualState>
      <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="DayRoot.Opacity" Value=".3"/></VisualState.Setters></VisualState>
     </VisualStateGroup>
     <VisualStateGroup x:Name="DateSelectionStates">
      <VisualState x:Name="DayOrdinary"/>
      <VisualState x:Name="DayToday"><VisualState.Setters><Setter Target="Today.Visibility" Value="Visible"/><Setter Target="DayText.Foreground" Value="{ThemeResource BleeckerSeaBrush}"/><Setter Target="DayText.FontFamily" Value="{StaticResource BleeckerPrimarySemiboldFontFamily}"/><Setter Target="DayText.FontWeight" Value="SemiBold"/></VisualState.Setters></VisualState>
      <VisualState x:Name="DaySelected"><VisualState.Setters><Setter Target="Selected.Visibility" Value="Visible"/><Setter Target="DayText.Foreground" Value="{ThemeResource BleeckerDateSelectedForegroundBrush}"/><Setter Target="DayText.FontFamily" Value="{StaticResource BleeckerPrimarySemiboldFontFamily}"/><Setter Target="DayText.FontWeight" Value="SemiBold"/></VisualState.Setters></VisualState>
     </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Border x:Name="Hover" CornerRadius="6" Background="{ThemeResource BleeckerDateDayHoverBrush}" Opacity="0"/>
    <Border x:Name="Today" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource BleeckerDateTodayRingBrush}" Visibility="Collapsed"/>
    <Border x:Name="Selected" CornerRadius="6" Background="{ThemeResource BleeckerSeaBrush}" Visibility="Collapsed"/>
    <TextBlock x:Name="DayText" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="13" LineHeight="19.5" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="False" IsHitTestVisible="False"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BleeckerDateTriggerStyle" TargetType="Button">
  <Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="200"/><Setter Property="Padding" Value="14,0"/><Setter Property="CornerRadius" Value="7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{ThemeResource BleeckerDateTriggerBorderBrush}"/><Setter Property="Background" Value="{ThemeResource BleeckerDateSurfaceBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="UseSystemFocusVisuals" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="HighContrastAdjustment" Value="None"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid x:Name="TriggerRoot">
    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="DateTriggerStates">
     <VisualState x:Name="TriggerRest"/>
     <VisualState x:Name="TriggerHovered"><VisualState.Setters><Setter Target="Chrome.BorderBrush" Value="{ThemeResource BleeckerDateTriggerHoverBrush}"/></VisualState.Setters></VisualState>
     <VisualState x:Name="TriggerFocused"><VisualState.Setters><Setter Target="Chrome.BorderBrush" Value="{ThemeResource BleeckerDateTriggerFocusBrush}"/><Setter Target="Ring.Opacity" Value="1"/></VisualState.Setters></VisualState>
     <VisualState x:Name="TriggerDisabled"><VisualState.Setters><Setter Target="TriggerRoot.Opacity" Value=".5"/></VisualState.Setters></VisualState>
    </VisualStateGroup></VisualStateManager.VisualStateGroups>
    <Border x:Name="Ring" BorderBrush="{ThemeResource BleeckerDateTriggerRingBrush}" BorderThickness="2" Margin="-2" CornerRadius="9" Opacity="0"/>
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/></Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
