<!-- Generated from pinned Bleecker pagination.tsx; use scripts/generate-pagination-palettes.mjs. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" Opacity="1"/>
   <SolidColorBrush x:Key="ButtonForeground" Color="#2D2D2D" Opacity="1"/>
   <SolidColorBrush x:Key="ButtonBorderBrush" Color="#E6D5B8" Opacity="0.3"/>
   <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F9F6F2" Opacity="0.5"/>
   <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#2D2D2D" Opacity="1"/>
   <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#E6D5B8" Opacity="0.6"/>
   <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#F9F6F2" Opacity="0.5"/>
   <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#2D2D2D" Opacity="1"/>
   <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#E6D5B8" Opacity="0.6"/>
   <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FFFFFF" Opacity="1"/>
   <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#2D2D2D" Opacity="1"/>
   <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#E6D5B8" Opacity="0.3"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="ButtonBackground" Color="#182533" Opacity="1"/>
   <SolidColorBrush x:Key="ButtonForeground" Color="#F0F4F8" Opacity="1"/>
   <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFFFFF" Opacity="0.15"/>
   <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFFF" Opacity="0.06"/>
   <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F0F4F8" Opacity="1"/>
   <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#1A2332" Opacity="0.6"/>
   <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFFFFF" Opacity="0.06"/>
   <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F0F4F8" Opacity="1"/>
   <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#1A2332" Opacity="0.6"/>
   <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#182533" Opacity="1"/>
   <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#F0F4F8" Opacity="1"/>
   <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FFFFFF" Opacity="0.15"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
  <Setter Property="Background" Value="{ThemeResource ButtonBackground}"/>
  <Setter Property="BackgroundSizing" Value="OuterBorderEdge"/>
  <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}"/>
  <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Height" Value="36"/>
  <Setter Property="MinHeight" Value="36"/>
  <Setter Property="MinWidth" Value="22"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="CornerRadius" Value="{StaticResource BleeckerButtonCornerRadius}"/>
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="UseSystemFocusVisuals" Value="True"/>
  <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BleeckerSeaBrush}"/>
  <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
  <Setter Property="FocusVisualSecondaryThickness" Value="2"/>
  <Setter Property="FocusVisualMargin" Value="-4"/>
 </Style>
</ResourceDictionary>
