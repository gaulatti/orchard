<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style TargetType="local:BleeckerDataList">
  <Setter Property="IsTabStop" Value="False" /><Setter Property="UseLayoutRounding" Value="False" /><Setter Property="HighContrastAdjustment" Value="None" />
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}" /><Setter Property="FontSize" Value="14" />
  <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerDataList">
   <Grid>
    <StackPanel x:Name="PART_Rows" FlowDirection="LeftToRight" UseLayoutRounding="False" />
    <TextBlock x:Name="PART_Primary" Visibility="Collapsed" Foreground="{TemplateBinding Foreground}" />
    <TextBlock x:Name="PART_Secondary" Visibility="Collapsed" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" />
    <TextBlock x:Name="PART_Divider" Visibility="Collapsed" Foreground="{ThemeResource BleeckerBorderBrush}" />
    <TextBlock x:Name="PART_Stripe" Visibility="Collapsed" Foreground="{ThemeResource BleeckerDataListStripeBrush}" />
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
