<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style x:Key="BleeckerMediaLibraryOpenStyle" TargetType="Button">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="UseSystemFocusVisuals" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="{TemplateBinding Background}" UseLayoutRounding="False"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"/></VisualStateGroup><VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused"/><VisualState x:Name="Focused"/><VisualState x:Name="PointerFocused"/></VisualStateGroup></VisualStateManager.VisualStateGroups><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/></Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BleeckerMediaLibraryTileStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource BleeckerMediaTileBackgroundBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource BleeckerMediaTileBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="UseLayoutRounding" Value="False"/></Style>
 <Style TargetType="local:BleeckerMediaLibrary">
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/><Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerMediaLibrary"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" UseLayoutRounding="False"><Grid UseLayoutRounding="False">
   <TextBlock x:Name="PART_Primary" Foreground="{ThemeResource BleeckerTextPrimaryBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_Secondary" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_Desert" Foreground="{ThemeResource BleeckerDesertBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_TileBackground" Foreground="{ThemeResource BleeckerMediaTileBackgroundBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_TileBorder" Foreground="{ThemeResource BleeckerMediaTileBorderBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_TileHoverBorder" Foreground="{ThemeResource BleeckerMediaTileHoverBorderBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_Overlay" Foreground="{ThemeResource BleeckerMediaOverlayBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_OverlayText" Foreground="{ThemeResource BleeckerMediaOverlayTextBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_Delete" Foreground="{ThemeResource BleeckerTerracottaBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_Placeholder" Foreground="{ThemeResource BleeckerMediaPlaceholderBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_EmptyBackground" Foreground="{ThemeResource BleeckerMediaEmptyBackgroundBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_EmptyBorder" Foreground="{ThemeResource BleeckerMediaEmptyBorderBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_PreviewBackground" Foreground="{ThemeResource BleeckerMediaPreviewBackgroundBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_PreviewBorder" Foreground="{ThemeResource BleeckerMediaPreviewBorderBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_Link" Foreground="{ThemeResource BleeckerFileChooseForegroundBrush}" Visibility="Collapsed"/>
   <TextBlock x:Name="PART_Focus" Foreground="{ThemeResource BleeckerMediaFocusBrush}" Visibility="Collapsed"/>
   <Grid x:Name="PART_Root" UseLayoutRounding="False"/>
  </Grid></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
