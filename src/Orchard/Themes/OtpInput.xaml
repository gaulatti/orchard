<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <SolidColorBrush x:Key="BleeckerOtpWhiteBrush" Color="White"/>
 <ControlTemplate x:Key="BleeckerOtpTextTemplate" TargetType="TextBox"><Grid Background="Transparent">
  <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Focused"/><VisualState x:Name="Disabled"/></VisualStateGroup></VisualStateManager.VisualStateGroups>
  <ScrollViewer x:Name="ContentElement" Margin="{TemplateBinding BorderThickness}" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" IsTabStop="False" ZoomMode="Disabled" AutomationProperties.AccessibilityView="Raw"/>
 </Grid></ControlTemplate>
 <ControlTemplate x:Key="BleeckerOtpPasswordTemplate" TargetType="PasswordBox"><Grid Background="Transparent">
  <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Focused"/><VisualState x:Name="Disabled"/></VisualStateGroup></VisualStateManager.VisualStateGroups>
  <Canvas Opacity="0" IsHitTestVisible="False"><TextBlock x:Name="OtpMaskMetrics" Text="{TemplateBinding PasswordChar}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" CharacterSpacing="{TemplateBinding CharacterSpacing}" IsTextScaleFactorEnabled="{TemplateBinding IsTextScaleFactorEnabled}" AutomationProperties.AccessibilityView="Raw"/></Canvas>
  <ScrollViewer x:Name="ContentElement" Width="{Binding ActualWidth, ElementName=OtpMaskMetrics}" MinWidth="1" Margin="{TemplateBinding BorderThickness}" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" IsTabStop="False" ZoomMode="Disabled" AutomationProperties.AccessibilityView="Raw"/>
 </Grid></ControlTemplate>
 <Style TargetType="local:BleeckerOtpInput">
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimarySemiboldFontFamily}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="18"/><Setter Property="CharacterSpacing" Value="80"/><Setter Property="Spacing" Value="8"/>
  <Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="AutomationProperties.Name" Value="One-time password input"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerOtpInput"><Grid Padding="{TemplateBinding Padding}">
   <Canvas Opacity="0" IsHitTestVisible="False">
    <TextBlock x:Name="OtpWhitePalette" Foreground="{ThemeResource BleeckerOtpWhiteBrush}"/>
    <TextBlock x:Name="OtpSandPalette" Foreground="{ThemeResource BleeckerSandBrush}"/>
    <TextBlock x:Name="OtpSeaPalette" Foreground="{ThemeResource BleeckerSeaBrush}"/>
    <TextBlock x:Name="OtpDeepSeaPalette" Foreground="{ThemeResource BleeckerDeepSeaBrush}"/>
    <TextBlock x:Name="OtpTextPalette" Foreground="{ThemeResource BleeckerTextPrimaryBrush}"/>
   </Canvas>
   <Grid x:Name="PART_Items"/>
  </Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
