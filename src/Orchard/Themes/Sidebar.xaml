<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style TargetType="local:BleeckerSidebar">
  <Setter Property="UseLayoutRounding" Value="False" /><Setter Property="IsTabStop" Value="False" />
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" /><Setter Property="FontSize" Value="16" />
  <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
  <Setter Property="Background" Value="{ThemeResource BleeckerSidebarBackgroundBrush}" />
  <Setter Property="BorderBrush" Value="{ThemeResource BleeckerSidebarBorderBrush}" /><Setter Property="BorderThickness" Value="0,0,1,0" />
  <Setter Property="Padding" Value="12,20" /><Setter Property="HorizontalAlignment" Value="Left" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerSidebar">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><Grid x:Name="PART_Items" /></Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
