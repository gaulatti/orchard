<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style TargetType="local:BleeckerActivityItem">
  <Setter Property="IsTabStop" Value="False" /><Setter Property="UseSystemFocusVisuals" Value="False" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
  <Setter Property="HighContrastAdjustment" Value="None" /><Setter Property="UseLayoutRounding" Value="False" />
  <Setter Property="Padding" Value="16" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{ThemeResource BleeckerActivityBorderBrush}" />
  <Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerActivityItem">
   <Border x:Name="PART_Surface" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <local:BleeckerAvatar x:Name="PART_Avatar" AvatarSize="Small" VerticalAlignment="Top" />
     <Grid Grid.Column="1" MinWidth="0" VerticalAlignment="Top">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBlock x:Name="PART_Title" FontFamily="{StaticResource BleeckerPrimaryMediumFontFamily}" FontWeight="Medium" FontSize="13" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
      <TextBlock x:Name="PART_Time" Grid.Row="2" FontFamily="{StaticResource BleeckerSecondaryFontFamily}" FontWeight="Normal" FontSize="11" LineHeight="16.5" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" />
     </Grid>
     <TextBlock x:Name="PART_Hover" Foreground="{ThemeResource BleeckerActivityHoverBrush}" Visibility="Collapsed" />
     <TextBlock x:Name="PART_HoverText" Foreground="{ThemeResource BleeckerActivityHoverForegroundBrush}" Visibility="Collapsed" />
     <TextBlock x:Name="PART_TimeText" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" Visibility="Collapsed" />
    </Grid>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
