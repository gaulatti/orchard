<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style TargetType="local:BleeckerPageHeader">
  <Setter Property="IsTabStop" Value="False" /><Setter Property="UseSystemFocusVisuals" Value="False" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="UseLayoutRounding" Value="False" />
  <Setter Property="HighContrastAdjustment" Value="None" />
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}" /><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerPageHeader">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><StackPanel Spacing="20">
    <ContentPresenter x:Name="PART_Breadcrumbs" Content="{TemplateBinding Breadcrumbs}" ContentTemplate="{TemplateBinding BreadcrumbsTemplate}" FontSize="14" FontFamily="{StaticResource BleeckerPrimaryFontFamily}" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" />
    <Grid x:Name="PART_Row">
     <Grid x:Name="PART_Lead" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid x:Name="PART_Back" Margin="0,2,0,0" VerticalAlignment="Top">
       <ContentControl x:Name="PART_BackIcon" IsTabStop="False" IsHitTestVisible="False"><ContentControl.Template><ControlTemplate TargetType="ContentControl"><Viewbox Width="18" Height="18" FlowDirection="LeftToRight"><Canvas Width="24" Height="24"><Path Data="M15 18 9 12 15 6" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox></ControlTemplate></ContentControl.Template></ContentControl>
      </Grid>
      <StackPanel Grid.Column="1">
       <!-- CSS 36.8px resolves to 36.796875px in the pinned browser reference. -->
       <TextBlock x:Name="PART_Title" Text="{TemplateBinding Title}" Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource BleeckerPrimarySemiboldFontFamily}" FontSize="32" FontWeight="SemiBold" LineHeight="36.796875" LineStackingStrategy="BlockLineHeight" CharacterSpacing="-20" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
       <TextBlock x:Name="PART_Description" Text="{TemplateBinding Description}" Margin="0,10,0,0" MaxWidth="672" HorizontalAlignment="Left" Foreground="{ThemeResource BleeckerTextSecondaryBrush}" FontFamily="{StaticResource BleeckerSecondaryFontFamily}" FontSize="14" LineHeight="24" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
      </StackPanel>
     </Grid>
     <Grid x:Name="PART_Actions" VerticalAlignment="Top" />
    </Grid>
   </StackPanel></Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
