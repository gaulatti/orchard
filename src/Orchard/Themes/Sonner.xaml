<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style x:Key="BleeckerSonnerSurfaceStyle" TargetType="local:BleeckerOverlaySurface">
  <Setter Property="Background" Value="{ThemeResource BleeckerAlertBackgroundBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource BleeckerSonnerBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/><Setter Property="UseLayoutRounding" Value="False"/>
 </Style>
 <Style x:Key="BleeckerSonnerDismissButtonStyle" TargetType="Button">
  <Setter Property="Padding" Value="2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextSecondaryBrush}"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="CornerRadius" Value="6"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
  <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BleeckerAccentBlueBrush}"/><Setter Property="FocusVisualPrimaryThickness" Value="2"/><Setter Property="FocusVisualSecondaryThickness" Value="0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" UseLayoutRounding="False" RenderTransformOrigin=".5,.5"><Grid.RenderTransform><ScaleTransform x:Name="PressScale"/></Grid.RenderTransform>
   <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource BleeckerSonnerCloseHoverBrush}"/><Setter Target="Content.Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource BleeckerSonnerCloseHoverBrush}"/><Setter Target="Content.Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/><Setter Target="PressScale.ScaleX" Value=".9"/><Setter Target="PressScale.ScaleY" Value=".9"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value=".5"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
   <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" UseLayoutRounding="False"/>
  </Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BleeckerSonnerLinkActionStyle" TargetType="Button">
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryMediumFontFamily}"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource BleeckerSeaBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="Root" Background="{TemplateBinding Background}" UseLayoutRounding="False">
   <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Content.Foreground" Value="{ThemeResource BleeckerNotificationLinkHoverBrush}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Content.Foreground" Value="{ThemeResource BleeckerNotificationLinkHoverBrush}"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value=".5"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
   <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" UseLayoutRounding="False"/>
   <Border Height="1" VerticalAlignment="Bottom" Margin="0,0,0,-2" Background="{Binding Foreground, ElementName=Content}" IsHitTestVisible="False"/>
  </Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BleeckerSonnerButtonActionStyle" TargetType="local:BleeckerButton"><Setter Property="Size" Value="Small"/></Style>
 <Style TargetType="local:BleeckerSonner">
  <Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="FontSize" Value="16"/>
  <Setter Property="SurfaceStyle" Value="{StaticResource BleeckerSonnerSurfaceStyle}"/><Setter Property="DismissButtonStyle" Value="{StaticResource BleeckerSonnerDismissButtonStyle}"/><Setter Property="LinkActionStyle" Value="{StaticResource BleeckerSonnerLinkActionStyle}"/><Setter Property="ButtonActionStyle" Value="{StaticResource BleeckerSonnerButtonActionStyle}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerSonner"><Grid x:Name="PART_Declaration" Height="0" MinHeight="0" UseLayoutRounding="False"/></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
