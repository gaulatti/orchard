<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <Style TargetType="local:BleeckerAuthShell">
  <Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="HorizontalAlignment" Value="Left"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="FontSize" Value="16"/>
  <Setter Property="Background" Value="{ThemeResource BleeckerAuthShellCanvasBrush}"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/>
  <Setter Property="AccessBackground" Value="{ThemeResource BleeckerBackgroundBrush}"/><Setter Property="AsideBackground" Value="{ThemeResource BleeckerDeepSeaBrush}"/>
  <Setter Property="AsideForeground" Value="{ThemeResource BleeckerAuthShellAsideForegroundBrush}"/><Setter Property="FooterForeground" Value="{ThemeResource BleeckerTextSecondaryBrush}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerAuthShell">
   <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" UseLayoutRounding="False"><Grid x:Name="PART_Layout" UseLayoutRounding="False"/></Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
