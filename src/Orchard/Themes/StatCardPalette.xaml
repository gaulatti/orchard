<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="BleeckerStatTrendUpBrush" Color="#009966" />
   <SolidColorBrush x:Key="BleeckerStatIconBackgroundBrush" Color="#2C5784" Opacity="0.045" /><SolidColorBrush x:Key="BleeckerStatIconBorderBrush" Color="#2C5784" Opacity="0.12" />
   <SolidColorBrush x:Key="BleeckerStatIconForegroundBrush" Color="#2C5784" /><SolidColorBrush x:Key="BleeckerStatFooterBorderBrush" Color="#E6D5B8" Opacity="0.2" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="BleeckerStatTrendUpBrush" Color="#00D492" />
   <SolidColorBrush x:Key="BleeckerStatIconBackgroundBrush" Color="#5BA3F5" Opacity="0.08" /><SolidColorBrush x:Key="BleeckerStatIconBorderBrush" Color="#5BA3F5" Opacity="0.18" />
   <SolidColorBrush x:Key="BleeckerStatIconForegroundBrush" Color="#5BA3F5" /><SolidColorBrush x:Key="BleeckerStatFooterBorderBrush" Color="White" Opacity="0.1" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="BleeckerStatTrendUpBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
   <SolidColorBrush x:Key="BleeckerStatIconBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="BleeckerStatIconBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
   <SolidColorBrush x:Key="BleeckerStatIconForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" /><SolidColorBrush x:Key="BleeckerStatFooterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
