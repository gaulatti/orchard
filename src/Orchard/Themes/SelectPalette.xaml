<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="SelectBackground" Color="White"/><SolidColorBrush x:Key="SelectDisabled" Color="#F9F6F2" Opacity=".65"/>
   <SolidColorBrush x:Key="SelectBorder" Color="#E6D5B8" Opacity=".4"/><SolidColorBrush x:Key="SelectHeaderBorder" Color="#E6D5B8" Opacity=".35"/><SolidColorBrush x:Key="SelectHover" Color="#E6D5B8" Opacity=".7"/>
   <SolidColorBrush x:Key="SelectFocus" Color="#2C5784" Opacity=".7"/><SolidColorBrush x:Key="SelectRing" Color="#2C5784" Opacity=".1"/><SolidColorBrush x:Key="SelectError" Color="#A65D57"/><SolidColorBrush x:Key="SelectErrorRing" Color="#A65D57" Opacity=".15"/>
   <SolidColorBrush x:Key="SelectPopupBackground" Color="White"/><SolidColorBrush x:Key="SelectPopupBorder" Color="#E6D5B8" Opacity=".4"/>
   <SolidColorBrush x:Key="SelectOptionBackground" Color="Transparent"/><SolidColorBrush x:Key="SelectOptionHighlight" Color="#F9F6F2"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="SelectBackground" Color="#182533"/><SolidColorBrush x:Key="SelectDisabled" Color="#0D1821" Opacity=".65"/>
   <SolidColorBrush x:Key="SelectBorder" Color="White" Opacity=".15"/><SolidColorBrush x:Key="SelectHeaderBorder" Color="White" Opacity=".15"/><SolidColorBrush x:Key="SelectHover" Color="White" Opacity=".25"/>
   <SolidColorBrush x:Key="SelectFocus" Color="#5BA3F5"/><SolidColorBrush x:Key="SelectRing" Color="#5BA3F5" Opacity=".12"/><SolidColorBrush x:Key="SelectError" Color="#D47B75"/><SolidColorBrush x:Key="SelectErrorRing" Color="#D47B75" Opacity=".15"/>
   <SolidColorBrush x:Key="SelectPopupBackground" Color="#182533"/><SolidColorBrush x:Key="SelectPopupBorder" Color="White" Opacity=".15"/>
   <SolidColorBrush x:Key="SelectOptionBackground" Color="Transparent"/><SolidColorBrush x:Key="SelectOptionHighlight" Color="White" Opacity=".07"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="SelectBackground" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="SelectDisabled" Color="{ThemeResource SystemColorWindowColor}"/>
   <SolidColorBrush x:Key="SelectBorder" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="SelectHeaderBorder" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="SelectHover" Color="{ThemeResource SystemColorHighlightColor}"/>
   <SolidColorBrush x:Key="SelectFocus" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="SelectRing" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="SelectError" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="SelectErrorRing" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="SelectPopupBackground" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="SelectPopupBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="SelectOptionBackground" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="SelectOptionHighlight" Color="{ThemeResource SystemColorHighlightColor}"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
