<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchard">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Orchard/Themes/SelectPalette.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style x:Key="BleeckerSelectStyle" TargetType="local:BleeckerSelect">
  <Setter Property="IsTabStop" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/>
  <Setter Property="FontFamily" Value="{StaticResource BleeckerPrimaryFontFamily}"/><Setter Property="Foreground" Value="{ThemeResource BleeckerTextPrimaryBrush}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BleeckerSelect"><Grid x:Name="PART_Layout" FlowDirection="LeftToRight" UseLayoutRounding="False"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="local:BleeckerSelect" BasedOn="{StaticResource BleeckerSelectStyle}"/>
 <Style TargetType="local:BleeckerHeaderSelect" BasedOn="{StaticResource BleeckerSelectStyle}">
  <Setter Property="Size" Value="Small"/><Setter Property="Placeholder" Value="Select option"/><Setter Property="MinWidth" Value="144"/><Setter Property="MaxWidth" Value="208"/><Setter Property="HorizontalAlignment" Value="Left"/>
 </Style>
</ResourceDictionary>
